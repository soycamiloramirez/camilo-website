# camilo-ramirez.com — variables de entorno (configurar en Vercel).
# Copia a .env para desarrollo local. NUNCA subir .env con valores reales.

# --- Contacto / Newsletter (Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=yo@camilo-ramirez.com
CONTACT_FROM_EMAIL=forms@send.camilo-ramirez.com
NEWSLETTER_CONFIRM_SECRET=            # 16+ chars; firma los tokens de doble opt-in

# --- Anti-spam: token de sesión de formulario (HMAC) ---
# Firma el token que /api/form-token emite y que /api/contact y /api/subscribe
# exigen. Cierra el hueco del POST directo de bots (sin token válido → rechazo).
# Si NO se define, cae a un secreto estable por-deploy (derivado de
# NEWSLETTER_CONFIRM_SECRET / VERCEL_GIT_COMMIT_SHA) y el sitio NO se rompe.
# Recomendado definirlo con un valor aleatorio de 32+ chars.
FORM_TOKEN_SECRET=

# --- Anti-spam: Cloudflare Turnstile (opcional) ---
# Si AMBAS están definidas, /api/contact y /api/subscribe EXIGEN el token de
# Turnstile (rechazo si inválido/ausente). Sin ellas, el sitio funciona igual
# (fail-open) apoyándose en las otras capas. Esto es lo que frena bots headless.
PUBLIC_TURNSTILE_SITE_KEY=            # site key del widget (cliente, build-time)
TURNSTILE_SECRET_KEY=                 # secret para siteverify (server)
