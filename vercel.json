{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/ds-assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(avif|webp|jpg|jpeg|png|svg|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    {
      "source": "/podcasts-recomendados",
      "destination": "/podcasts",
      "permanent": true
    },
    {
      "source": "/trabajar",
      "destination": "/#trabajar",
      "permanent": true
    },
    {
      "source": "/podcasts-recomendados/:path*",
      "destination": "/podcasts",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/newsletter-draft",
      "schedule": "30 13 * * 5"
    }
  ]
}
