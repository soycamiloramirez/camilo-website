{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/podcasts-recomendados",
      "destination": "/podcasts",
      "permanent": true
    },
    {
      "source": "/trabajar",
      "destination": "/#trabajar",
      "permanent": true
    },
    {
      "source": "/podcasts-recomendados/:path*",
      "destination": "/podcasts",
      "permanent": true
    }
  ]
}
