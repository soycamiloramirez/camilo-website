---
import '../styles/global.css';
import '../styles/ds.css';
import { COPY, SITE, SOCIALS, type Lang } from '../content/copy';
const {
  lang,
  pageTitle,
  pageDescription,
  pageType = 'profile',
  path,
  extraJsonLd = [],
  hasAlternate = true,
  noindex = false,
  ogImage,
} = Astro.props as {
  lang: Lang;
  pageTitle?: string;
  pageDescription?: string;
  pageType?: 'profile' | 'article' | 'website';
  path?: string;
  extraJsonLd?: Record<string, unknown>[];
  /**
   * Whether the current page has a sibling in the other locale.
   * Set to false for ES-only pages like /blog/* so we don't advertise
   * non-existent EN URLs in hreflang.
   */
  hasAlternate?: boolean;
  /**
   * If true, emit `robots: noindex` so crawlers skip the page.
   * Used for hidden posts (style guide) that are reachable by URL but
   * shouldn't appear in search.
   */
  noindex?: boolean;
  /**
   * Override del OG image por página. Si no se pasa, usa el default `og-image.jpg`.
   * Útil para blog posts que tienen `hero_image` en frontmatter para mejorar CTR
   * en LinkedIn/Twitter (cada post con su propia visual). Path puede ser absoluto
   * (https://...) o relativo (/path/img.jpg) — se resuelve contra SITE.url.
   */
  ogImage?: string;
};
const t = COPY[lang];

const homePath = lang === 'es' ? '/' : '/en';
const currentPath = path ?? homePath;
const altPath = path
  ? (lang === 'es' ? path.replace(/^\//, '/en/') : path.replace(/^\/en\//, '/'))
  : (lang === 'es' ? '/en' : '/');

const canonical = `${SITE.url}${currentPath === '/' ? '/' : currentPath}`;
const altUrl = `${SITE.url}${altPath}`;

const title = pageTitle ?? t.meta.title;
const description = pageDescription ?? t.meta.description;

// Person entity — the central node of the Knowledge Graph for Camilo.
// Includes alternateName, knowsAbout (subjects), nationality, gender, and
// extended sameAs (socials + podcast platforms + companies).
const personJsonLd = {
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: 'Camilo Ramírez',
  alternateName: ['Camilo Ramirez', 'soy.camilo.ramirez'],
  givenName: 'Camilo',
  familyName: 'Ramírez',
  url: SITE.url,
  image: `${SITE.url}/camilo-hero.jpg`,
  jobTitle:
    lang === 'es'
      ? 'Voz de IA y negocios en LATAM · Advisor · Speaker'
      : 'Voice on AI and business in LATAM · Advisor · Speaker',
  description: t.meta.description,
  nationality: { '@type': 'Country', name: 'Colombia' },
  knowsAbout: [
    'Artificial Intelligence',
    'AI for business',
    'AI governance',
    'AI adoption in Latin America',
    'Generative AI strategy',
    'Business strategy',
    'C-level advisory',
    'Board advisory',
    'Latin America technology ecosystem',
    'Digital business',
    'Public speaking',
    'Keynote speaking',
    'Podcasting',
    'Editorial criticism',
    'Technology geopolitics',
  ],
  knowsLanguage: ['es', 'en'],
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://navigamo.co/#org',
    name: 'Navigamo',
    url: 'https://navigamo.co',
    description: 'Compañía de IA que diseña y opera soluciones para empresas en LATAM. Cofundada por Camilo Ramírez en 2024.',
  },
  memberOf: [
    {
      '@type': 'Organization',
      '@id': 'https://aicollective.com/#org',
      name: 'The AI Collective',
      url: 'https://aicollective.com',
      description: 'La comunidad de IA más grande del planeta: 200.000+ miembros, 180+ capítulos en 40+ países. Camilo Ramírez es Director Regional LATAM desde 2025.',
    },
    { '@type': 'Organization', name: 'IAB Colombia (alumni, junta directiva 2014-2022)' },
  ],
  hasOccupation: [
    {
      '@type': 'Occupation',
      name: 'Advisor estratégico C-level',
      occupationLocation: { '@type': 'Country', name: 'Colombia' },
      skills: 'AI strategy, business decisions, board sessions, adoption planning',
    },
    {
      '@type': 'Occupation',
      name: 'Keynote speaker',
      occupationLocation: { '@type': 'Place', name: 'LATAM, North America, Europe' },
      skills: 'AI for business, governance, C-level fundamentals',
    },
    {
      '@type': 'Occupation',
      name: 'Podcast host',
      skills: 'Pertinente (daily), Métase en mi cabeza (weekly TV + podcast)',
    },
  ],
  award: [
    'Certified Experienced Speaker',
    'Jury · Effie Awards',
    'Jury · FIAP',
    'Jury · PromaxBDA',
    'Board member · IAB Colombia (2014-2022)',
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressRegion: 'Cundinamarca', addressCountry: 'CO' },
  /* sameAs: lista canonical de URLs externos que describen a esta misma entidad.
     Ayuda a Knowledge Graph de Google y a LLMs (ChatGPT, Claude, Perplexity,
     Gemini) a reconocer la entidad como una sola persona verificada cross-platform. */
  sameAs: [
    /* URL canónica de YouTube usando channel ID (UCeR6eg0Hph25YqSBKQjZkJw).
       La URL con @handle sigue en SOCIALS para usuarios. */
    'https://www.youtube.com/channel/UCeR6eg0Hph25YqSBKQjZkJw',
    ...SOCIALS.map((s) => s.href),
    'https://open.spotify.com/show/2bOwCqIBN1uRj5Ms84CnFe',
    'https://podcasts.apple.com/us/podcast/pertinente-con-camilo-ram%C3%ADrez/id1894335566',
    'https://open.spotify.com/show/7fzBFk8AGRc7ptnho5jZOB',
    'https://navigamo.co',
    'https://aicollective.com',
  ],
  email: `mailto:${SITE.email}`,
};

// ProfilePage wrapper — el marcado que Google recomienda para perfiles de
// creador/persona. mainEntity apunta a la Person (#person) vía @id, así que la
// entidad Person no se duplica: se define una sola vez y se referencia.
// Emitimos un @graph con ambos nodos (ProfilePage + Person).
const profilePageJsonLd = {
  '@type': 'ProfilePage',
  '@id': `${SITE.url}/#profilepage`,
  url: SITE.url,
  name: 'Camilo Ramírez',
  mainEntity: { '@id': `${SITE.url}/#person` },
};

const personGraphJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [profilePageJsonLd, personJsonLd],
};

// Verificación de Google Search Console. Vacío por ahora: pegar aquí el token
// (solo el valor del content, sin el <meta>) cuando Camilo cree la propiedad en
// GSC. El meta se renderiza condicionalmente, así que dejarlo vacío no rompe nada.
const googleSiteVerification = '';
---
<!doctype html>
<html lang={lang === 'es' ? 'es-CO' : 'en-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Camilo Ramírez" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'es' ? 'es-CO' : 'en-US'} href={canonical} />
    {hasAlternate && (
      <>
        <link rel="alternate" hreflang={lang === 'es' ? 'en-US' : 'es-CO'} href={altUrl} />
        <link rel="alternate" hreflang="x-default" href={`${SITE.url}${currentPath === homePath ? '/' : currentPath}`} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Preload only the two above-the-fold criticals: Helvetica Neue Regular (cuerpo)
         y Bold (display). Los demás pesos y Fraunces (accent italic) cargan vía CSS con
         font-display:swap, sin competir con el LCP. -->
    <link rel="preload" href="/fonts/HelveticaNeue.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/HelveticaNeue-Bold.woff2" as="font" type="font/woff2" crossorigin />
    {/* Preload hero AVIF: es el LCP del home. La foto de Camilo se carga
        como background-image del .cr-hero__photo. Sin preload, el browser
        descubre la URL solo cuando parsea CSS. */}
    {(path === '/' || path === '/en') && (
      <>
        <link rel="preload" as="image" href="/ds-assets/camilo-hero-600.avif" type="image/avif" media="(max-width: 767px)" fetchpriority="high" />
        <link rel="preload" as="image" href="/ds-assets/camilo-hero-800.avif" type="image/avif" media="(min-width: 768px)" fetchpriority="high" />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="Blog · Camilo Ramírez" href={`${SITE.url}/blog/rss.xml`} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage ? (ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`) : `${SITE.url}/og-image.jpg`} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    {hasAlternate && (
      <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_CO'} />
    )}
    <meta property="og:site_name" content="Camilo Ramírez" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@soy_camilo_r" />
    <meta name="twitter:creator" content="@soy_camilo_r" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage ? (ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`) : `${SITE.url}/og-image.jpg`} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="msvalidate.01" content="90255CD86199BA9792E7A613722D9076" />
    {/* Google Search Console: pegar el token en la constante googleSiteVerification
        (arriba en el frontmatter) cuando Camilo cree la propiedad en GSC. El meta
        solo se renderiza si el valor no está vacío. */}
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(personGraphJsonLd)} />
    {extraJsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
    {import.meta.env.PROD && (
      <>
        {/* GA4 vía Partytown: gtag.js corre en un web worker, fuera del main thread.
            Ambos scripts son type="text/partytown". El main thread encola pageviews
            y eventos custom vía los stubs forward (dataLayer.push, gtag) definidos en
            astro.config. anonymize_ip se conserva. */}
        <script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-YNYELQBZ62"></script>
        <script type="text/partytown">
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-YNYELQBZ62', { anonymize_ip: true });
        </script>
        {/* Microsoft Clarity — heatmaps + session recordings. NO va en Partytown:
            se carga diferido en requestIdleCallback o en la primera interacción
            (scroll/click/tecla/touch), lo que ocurra primero. Sigue grabando a
            quien interactúa, sin costar main-thread en el arranque. */}
        <script is:inline>
          (function () {
            var loaded = false;
            function load() {
              if (loaded) return; loaded = true;
              (function(c,l,a,r,i,t,y){
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
              })(window, document, "clarity", "script", "wzczzppi54");
            }
            if ('requestIdleCallback' in window) { requestIdleCallback(load, { timeout: 6000 }); }
            else { setTimeout(load, 4000); }
            ['scroll','click','keydown','touchstart','pointerdown'].forEach(function (ev) {
              window.addEventListener(ev, load, { once: true, passive: true });
            });
          })();
        </script>
        {/* Web Vitals → GA4 via gtag(). El gtag está definido inline arriba en este
            mismo head antes de que web-vitals (async dynamic import) pueda disparar,
            asi que la 'race condition' es teorica: cuando web-vitals llama gtag,
            gtag ya existe como funcion (queue en dataLayer si gtag.js aun no carga). */}
        <script type="module" is:inline>
          import('https://unpkg.com/web-vitals@4?module').then(function (mod) {
            function send(name, metric) {
              if (typeof window.gtag !== 'function') return;
              window.gtag('event', name, {
                event_category: 'Web Vitals',
                event_label: metric.id,
                value: name === 'CLS' ? Math.round(metric.value * 1000) / 1000 : Math.round(metric.value),
                non_interaction: true,
                metric_rating: metric.rating,
              });
            }
            mod.onCLS(function (m) { send('CLS', m); });
            mod.onLCP(function (m) { send('LCP', m); });
            mod.onINP(function (m) { send('INP', m); });
            mod.onFCP(function (m) { send('FCP', m); });
            mod.onTTFB(function (m) { send('TTFB', m); });
          }).catch(function () { /* noop: si CDN falla, no rompemos el sitio */ });
        </script>
      </>
    )}
    {/* Cloudflare Turnstile — sólo si la site key está configurada (opcional). */}
    {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      ></script>
    )}
  </head>
  <body>
    {/* Anti-spam: señal de tiempo. Marca cuándo cargó la página y, en cualquier
        submit de formulario, escribe los ms transcurridos en el input oculto
        `form_elapsed` ANTES de que corra el handler del form (fase de captura).
        Inmune al skew de reloj (mide delta local) y al cacheo por CDN. */}
    <script is:inline>
      (function () {
        var loadedAt = Date.now();
        document.addEventListener(
          'submit',
          function (e) {
            var f = e.target;
            if (!f || !f.querySelector) return;
            var el = f.querySelector('input[name="form_elapsed"]');
            if (el) el.value = String(Date.now() - loadedAt);
          },
          true
        );
      })();
    </script>
    <slot />
    {import.meta.env.PROD && (
      <script is:inline>
        {/* Outbound click tracking → GA4 event 'click_outbound'.
            Captura click (left), auxclick (middle = scroll wheel, abre nueva pestaña),
            y contextmenu (right click usually = "open in new tab"). Sin esto se
            perdía 20-40% del tráfico LinkedIn/Twitter cuyos usuarios abren con middle. */}
        (function () {
          function handle(e) {
            var a = e.target.closest && e.target.closest('a[href]');
            if (!a) return;
            // Ignorar botones que no son left (0), middle (1) — solo nos importan esos para outbound.
            // right (2) lo dejamos pasar para contextmenu open-in-new-tab.
            if (e.type === 'click' && e.button !== 0 && e.button !== undefined) return;
            if (e.type === 'auxclick' && e.button !== 1) return;
            var href = a.getAttribute('href') || '';
            if (href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('#')) return;
            var isExternal = false;
            try {
              var url = new URL(href, window.location.origin);
              isExternal = url.host && url.host !== window.location.host;
            } catch (err) { return; }
            if (!isExternal) return;
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'click_outbound', {
                event_category: 'outbound',
                event_label: a.href,
                link_domain: (new URL(a.href)).host,
                link_text: (a.textContent || '').trim().slice(0, 80),
                click_type: e.type === 'auxclick' ? 'middle' : (e.button === 2 ? 'right' : 'left'),
              });
            }
          }
          document.addEventListener('click', handle, true);
          document.addEventListener('auxclick', handle, true);
        })();
      </script>
    )}
  </body>
</html>
