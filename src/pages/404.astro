---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const lang = 'es' as const;
---
<Base lang={lang} pageTitle="404 · Página no encontrada · Camilo Ramírez" pageDescription="La página que buscabas no existe. Vuelve al inicio o lee la historia." path="/404" hasAlternate={false} noindex={true}>
  <Header lang={lang} />
  <main>
    <section class="cr-pagehead" style="padding-bottom: var(--s-10)">
      <div class="cr-container">
        <p class="cr-eyebrow"><span class="cr-franja"></span>404</p>
        <h1 class="cr-pagehead__title"><span class="cr-d-thin">Esa página</span> no existe.</h1>
        <p class="cr-lead cr-pagehead__lead">El enlace puede estar mal o el contenido se movió. Mientras lo arreglo, hay tres puertas que sí funcionan.</p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
          <a class="cr-btn cr-btn--accent" href="/">Volver al inicio</a>
          <a class="cr-btn cr-btn--ghost" href="/blog">Leer el blog</a>
          <a class="cr-btn cr-btn--link" href="/historia">Mi historia →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
