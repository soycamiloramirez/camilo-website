---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { CATEGORIES, type CategorySlug } from '../../content.config';
import { SITE, PODCASTS } from '../../content/copy';

export async function getStaticPaths() {
  // Include hidden posts so they're reachable by direct URL (e.g. style guide),
  // but they're filtered out of listings and we add noindex in the layout.
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props as {
  post: Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
  all: Awaited<ReturnType<typeof getCollection<'blog'>>>;
};

const { Content } = await render(post);

const lang = 'es' as const;
const url = `${SITE.url}/blog/${post.id}`;
const dateShort = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'short', year: 'numeric' }).format(post.data.date);

const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMin = Math.max(1, Math.round(wordCount / 220));

const cats = post.data.categories as CategorySlug[];
const primary = cats[0];
const related = all
  .filter((p) => p.id !== post.id && !p.data.hidden && (p.data.categories as CategorySlug[]).includes(primary))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Title SEO: usa `seo_title` del frontmatter si existe (versión corta ≤60 chars),
// si no usa el `title` editorial. La autoría se establece via schema.org Person + author meta.
const pageTitle = post.data.seo_title ?? post.data.title;
const pageDescription = post.data.description;

const extraJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description: post.data.description,
    url,
    inLanguage: 'es-CO',
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    /* Author/publisher referencian la entidad Person canónica definida en Base.astro
       (@id = SITE.url + '#person'). Esto consolida señales de autoría para Google
       Knowledge Graph y para que LLMs (ChatGPT, Perplexity, Claude) reconozcan
       una sola entidad "Camilo Ramírez" en todas las citaciones. */
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    image: `${SITE.url}/og-image.jpg`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    articleSection: cats.map((c) => CATEGORIES[c].label),
    keywords: [...cats.map((c) => CATEGORIES[c].label), 'IA', 'inteligencia artificial', 'Latinoamérica', 'negocios'].join(', '),
    wordCount,
    /* Speakable: marca las partes del artículo aptas para Google Assistant /
       Alexa / lectores de pantalla. Le decimos que el título y el lede son
       los bloques que tienen sentido leer en voz alta cuando alguien busca
       el tema vía voice search. */
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.cr-article__title', '.cr-article__lede', '.cr-article__tldr p'],
    },
    /* Citation: el post nace de un episodio de Pertinente. Linkear como fuente
       primaria refuerza que es contenido editorial derivado, no parafraseo. */
    isPartOf: { '@type': 'Blog', '@id': `${SITE.url}/blog#blog` },
    ...(post.data.episode && {
      citation: {
        '@type': 'CreativeWork',
        name: `Pertinente · episodio ${post.data.episode}`,
        url: `${SITE.url}/pertinente`,
      },
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];

const primaryLabel = CATEGORIES[primary].label;
---
<Base lang={lang} pageTitle={pageTitle} pageDescription={pageDescription} pageType="article" path={`/blog/${post.id}`} extraJsonLd={extraJsonLd} hasAlternate={false} noindex={post.data.hidden}>
  <Header lang={lang} />

  <main>
    <article class="cr-article">
      <div class="cr-container">
        <div class="cr-article__wrap">

          <p class="cr-breadcrumb"><a href="/blog">Blog</a> · {primaryLabel}</p>
          <p class="cr-eyebrow" style="margin-top:24px"><span class="cr-franja"></span>{primaryLabel} · {dateShort}</p>
          <h1 class="cr-article__title">{post.data.title}</h1>
          <p class="cr-article__lede">{post.data.description}</p>
          <p class="cr-article__meta">Por <strong>Camilo Ramírez</strong> · {readingMin} min de lectura</p>

          {post.data.tldr && (
            <div class="cr-article__tldr">
              <p class="cr-article__tldr-lbl">TL;DR</p>
              <p>{post.data.tldr}</p>
            </div>
          )}

          <div class="cr-article__body">
            {post.data.aside && (
              <aside class="cr-article__aside">{post.data.aside}</aside>
            )}

            <Content />

            {post.data.pullquote && (
              <p class="cr-article__pull">{post.data.pullquote}</p>
            )}
          </div>

        </div>
      </div>

      <div class="cr-container">
        <div class="cr-artfoot">
          <div class="cr-artfoot__franja"></div>
          <div class="cr-artfoot__bio">
            <img src="/camilo-hero.jpg" alt="Camilo Ramírez">
            <p><strong>Camilo Ramírez</strong> · Advisor, speaker y host de Pertinente. <a href="/historia">Su historia →</a></p>
          </div>

          <div class="cr-artfoot__useful">
            <p class="cr-artfoot__useful-lbl">Si esto le sirvió</p>
            <div class="cr-artfoot__useful-row">
              <a class="cr-btn cr-btn--accent" href={PODCASTS.pertinente.platforms[0].href} target="_blank" rel="noopener">Escuchar Pertinente</a>
              <a class="cr-btn cr-btn--ghost" href="/speaking" style="color:#fff;border-color:rgba(255,255,255,.3)">Speaking</a>
            </div>
          </div>

          <div class="cr-artfoot__more">
            <a class="cr-btn cr-btn--link" href="/blog">Más en el blog →</a>
          </div>
        </div>
      </div>

      <div class="cr-container" style="margin-top: var(--s-8)">
        <div class="cr-article__wrap">
          <div class="cr-nl-post">
            <p class="cr-nl-post__lbl">Carta del viernes</p>
            <h3 class="cr-nl-post__h">¿Quiere una pieza así cada viernes?</h3>
            <p class="cr-nl-post__p">Curaduría editorial destilada de la semana. IA, negocios y LATAM. Una sola pieza, cero ruido.</p>
            <NewsletterForm variant="inline" theme="light" id={`nl-post-${post.id}`} />
          </div>
        </div>
      </div>

      {related.length > 0 && (
        <div class="cr-container" style="margin-top: var(--s-9)">
          <div class="cr-article__wrap">
            <p class="cr-eyebrow"><span class="cr-franja"></span>Sigue leyendo</p>
            <div class="cr-blog__list" style="margin-top: var(--s-5)">
              {related.map((p) => (
                <a class="cr-post" href={`/blog/${p.id}`}>
                  <span class="cr-post__cat">{CATEGORIES[(p.data.categories as CategorySlug[])[0]].label}</span>
                  <h3 class="cr-post__title">{p.data.title}</h3>
                  <span class="cr-post__meta">{new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'short', year: 'numeric' }).format(p.data.date)}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}
    </article>
  </main>

  <Footer lang={lang} />
</Base>

<style is:global>
  /* Breathing room before article body starts */
  .cr-article__body { margin-top: var(--s-7); }
</style>
