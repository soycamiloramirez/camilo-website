---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import CategoryNav from '../../../components/blog/CategoryNav.astro';
import { CATEGORIES, type CategorySlug } from '../../../content.config';
import { SITE } from '../../../content/copy';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return (Object.keys(CATEGORIES) as CategorySlug[]).map((key) => ({
    params: { slug: CATEGORIES[key].slug },
    props: {
      categoryKey: key,
      posts: posts
        .filter((p) => (p.data.categories as CategorySlug[]).includes(key))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { categoryKey, posts } = Astro.props as {
  categoryKey: CategorySlug;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
};
const cat = CATEGORIES[categoryKey];
const lang = 'es' as const;

const pageTitle = `${cat.label} — Blog · Camilo Ramírez`;
const pageDescription = `Artículos sobre ${cat.label.toLowerCase()} desde el blog de Camilo Ramírez. Criterio editorial sobre IA, negocios y LATAM.`;
---
<Base lang={lang} pageTitle={pageTitle} pageDescription={pageDescription} pageType="website" path={`/blog/categoria/${cat.slug}`} hasAlternate={false}>
  <Header lang={lang} />
  <main class="pt-28 pb-20 md:pt-36 md:pb-28">
    <header class="mx-auto max-w-5xl px-6 lg:px-10 mb-14">
      <p class="text-[11px] uppercase tracking-[0.18em] text-mute mb-6">
        <a href="/blog" class="hover:text-ink transition-colors">Blog</a> · {cat.label}
      </p>
      <h1 class="font-display text-[36px] md:text-[52px] leading-[1.05] tracking-[-0.035em] text-ink">
        {cat.label}.
      </h1>
      <p class="mt-5 text-[15px] text-mute">{posts.length} artículo{posts.length === 1 ? '' : 's'}</p>
    </header>

    <div class="mx-auto max-w-5xl px-6 lg:px-10">
      <CategoryNav current={categoryKey} />
      <div class="grid gap-10 md:gap-12">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>
