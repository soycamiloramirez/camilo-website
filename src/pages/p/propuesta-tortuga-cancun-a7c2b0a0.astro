---
// PROPUESTA PRIVADA — no indexable, no enlazada desde el sitio.
// Ruta no adivinable (sufijo aleatorio). El sitemap excluye /p/ (ver astro.config.mjs).
// Base.astro emite <meta robots noindex,nofollow> con noindex={true}, y en PROD
// carga GA4 (G-YNYELQBZ62) + Microsoft Clarity (wzczzppi54) para grabar la sesión.
// Bilingüe EN/ES con toggle en JS mínimo; default EN.
import Base from '../../layouts/Base.astro';

const lang = 'en' as const;
const pageTitle = 'Keynote proposal · Cancún 2026';
const pageDescription = 'Private proposal.';
---
<Base
  lang={lang}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageType="website"
  path="/p/propuesta-tortuga-cancun-a7c2b0a0"
  hasAlternate={false}
  noindex={true}
>
  <main class="pp" data-lang="en">
    <!-- LANGUAGE TOGGLE -->
    <div class="pp-langbar">
      <div class="cr-container pp-langbar__inner">
        <span class="pp-brand">Camilo Ramírez</span>
        <div class="pp-lang" role="group" aria-label="Language / Idioma">
          <button type="button" class="pp-lang__btn is-active" data-set-lang="en">EN</button>
          <span class="pp-lang__sep">/</span>
          <button type="button" class="pp-lang__btn" data-set-lang="es">ES</button>
        </div>
      </div>
    </div>

    <!-- ================= ENGLISH ================= -->
    <div class="pp-locale" data-locale="en">

      <!-- 1. HERO -->
      <section class="cr-pagehead">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Keynote proposal · Hotel Zilara, Cancún</p>
          <h1 class="cr-pagehead__title"><span class="cr-d-thin">A keynote that changes how your CEOs decide,</span> not one that entertains them.</h1>
          <p class="cr-lead cr-pagehead__lead">For the leadership gathering at Hotel Zilara, Cancún: 45 minutes on AI applied to responsible business decisions. Not a technology demo. A working session on judgment, aimed at people who run companies.</p>
        </div>
      </section>

      <!-- 2. THE ANGLE -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>The angle</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Most AI talks sell a poster.</span> This one starts somewhere more useful.</h2>
          <p class="cr-spk-band__p">Most AI talks sell a poster: sustainability, efficiency, the future. This one starts somewhere more useful for a room of CEOs.</p>
          <p class="cr-spk-band__p pp-mt">The subject is AI applied to responsible decisions. Deciding with better information, less noise, and a clearer view of the trade-offs. Lower cost and lighter environmental load are the consequence of deciding well, not the headline. That order matters, and a room of operators feels the difference immediately.</p>
          <p class="cr-spk-band__p pp-mt">I am not going to pose as an ESG authority, and I will not pretend to be one on stage. I build AI and I run businesses. That is the ground I speak from.</p>
          <p class="cr-spk-band__p pp-mt">For a group of resort CEOs inside a private equity portfolio, the talk can be tuned along one of these angles, chosen with you:</p>
          <div class="pp-angles">
            <article class="pp-angle">
              <h3 class="pp-angle__h">AI as a post-merger integration lever.</h3>
              <p class="pp-angle__p">Two operations become one. AI helps standardize decisions, surface what each property already knows, and close the gap between the numbers at the top and what happens on the floor.</p>
            </article>
            <article class="pp-angle">
              <h3 class="pp-angle__h">AI that lowers OPEX and protects margin.</h3>
              <p class="pp-angle__p">The language a fund actually speaks. Where AI moves the cost line without touching the guest experience, and where it does not.</p>
            </article>
            <article class="pp-angle">
              <h3 class="pp-angle__h">AI that stays invisible to the luxury guest.</h3>
              <p class="pp-angle__p">In luxury, the technology that shows is the technology that failed. Where AI belongs backstage, and why that is the point.</p>
            </article>
          </div>
          <p class="cr-spk-band__p pp-mt">One of these, not all three. We pick the one that fits your audience.</p>
        </div>
      </section>

      <!-- 3. WHO IS CAMILO -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Who is Camilo</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">The honest question a bureau asks:</span> can he hold a room of 70 CEOs.</h2>
          <p class="cr-spk-band__p">Here is the proof, and it is live, not a highlight reel. I host <strong>Métase en mi cabeza</strong>, a weekly program on national television (Red+/Claro) with top-tier guests, and <strong>Pertinente</strong>, a daily solo podcast. Weekly, on camera, with an audience. Daily, alone, carrying the full hour. That is stage command under real conditions, every week, for anyone to check.</p>
          <p class="cr-spk-band__p pp-mt">The rest of the ground I speak from: cofounder and LATAM Director at Navigamo, where I build AI, and Regional LATAM Director at The AI Collective. More than 25 years operating. I do not comment on AI from the outside. I build it and I run businesses with it.</p>
          <p class="pp-video"><a class="cr-btn cr-btn--ghost" href="[link]" data-placeholder>Watch a live segment [link]</a></p>
        </div>
      </section>

      <!-- 4. THREE KEYNOTE TOPICS -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>The three keynote topics</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Three tracks,</span> adaptable to the audience and the objective.</h2>
          <div class="cr-spk-topics pp-topics">
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">01</div>
              <h3 class="cr-spk-topic__h">AI Governance</h3>
              <p class="cr-spk-topic__p">How a board and a C-suite decide what AI does, what it is not allowed to do, and who answers for it.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">02</div>
              <h3 class="cr-spk-topic__h">Responsible corporate decisions with AI</h3>
              <p class="cr-spk-topic__p">Using AI to decide better, with the trade-offs on the table. This is the natural fit for the sustainability angle your event is asking about.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">03</div>
              <h3 class="cr-spk-topic__h">AI basics for the C-level</h3>
              <p class="cr-spk-topic__p">What every executive needs to understand to lead the conversation instead of delegating it blind.</p>
            </article>
          </div>
          <p class="cr-spk-band__p pp-mt">For this room, topic 2 is the likely center, with as much of 1 and 3 as the format allows.</p>
        </div>
      </section>

      <!-- 5. INVESTMENT -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Investment</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">USD 8,000</span> for the keynote.</h2>
          <p class="cr-spk-band__p">What that buys: a talk built for this specific room, prep conversations with you beforehand, and a speaker who can carry the main slot without a net. Delivery in Spanish or English, your call.</p>
          <p class="cr-spk-band__p pp-mt">Travel is billed separately and arranged by the client: flights, accommodation at Zilara, and ground transfers.</p>
          <p class="cr-spk-band__p pp-mt">To hold the date, a 50% deposit reserves it. The balance is due on the event date.</p>
        </div>
      </section>

      <!-- 6. LOGISTICS -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Logistics</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">The practical</span> details.</h2>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Date</div><div class="cr-spk-logi__v">September 17 or 18, to be confirmed.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Venue</div><div class="cr-spk-logi__v">Hotel Zilara, Cancún.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Language</div><div class="cr-spk-logi__v">Spanish or English.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Format</div><div class="cr-spk-logi__v">Main keynote, roughly 45 minutes, adjustable to your run of show.</div></div>
          </div>
        </div>
      </section>

      <!-- 7. TO TUNE IT -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>To tune it</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Three questions,</span> and the answers change the talk.</h2>
          <div class="cr-spk-topics pp-topics">
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">01</div>
              <p class="cr-spk-topic__p">Who are the roughly 70 CEOs. Sector, seniority, single portfolio or mixed room.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">02</div>
              <p class="cr-spk-topic__p">Who asked for the AI and sustainability crossover, and why. What do they want the room to walk out believing.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">03</div>
              <p class="cr-spk-topic__p">Format, duration, and objective. Opening the day, closing it, before or after dinner, and what has to happen next.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- 8. NEXT STEP (DARK) -->
      <section class="cr-cta-band">
        <div class="cr-container">
          <p class="cr-eyebrow cr-eyebrow--ondark" style="justify-content:center"><span class="cr-franja cr-franja--mag"></span>Next step</p>
          <h2 class="cr-cta-band__h"><span class="cr-d-thin">Two ways</span> forward.</h2>
          <p class="pp-cta__p">Hold September 17 or 18 with the 50% deposit, or a 20-minute call first so I can hear the room and you can decide with the real thing in front of you.</p>
          <a class="cr-btn cr-btn--accent" href="mailto:camilo@navigamo.co?subject=Keynote%20Canc%C3%BAn%202026">Reply here or write to camilo@navigamo.co →</a>
        </div>
      </section>
    </div>

    <!-- ================= ESPAÑOL ================= -->
    <div class="pp-locale" data-locale="es" hidden>

      <!-- 1. HERO -->
      <section class="cr-pagehead">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Propuesta de keynote · Hotel Zilara, Cancún</p>
          <h1 class="cr-pagehead__title"><span class="cr-d-thin">Un keynote que cambia cómo deciden sus CEOs,</span> no uno que los entretiene.</h1>
          <p class="cr-lead cr-pagehead__lead">Para el encuentro de líderes en el Hotel Zilara, Cancún: 45 minutos sobre IA aplicada a decisiones de negocio responsables. No es una demostración de tecnología. Es una sesión de trabajo sobre criterio, para gente que dirige empresas.</p>
        </div>
      </section>

      <!-- 2. EL ÁNGULO -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>El ángulo</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">La mayoría de las charlas de IA venden un póster.</span> Esta arranca en un lugar más útil.</h2>
          <p class="cr-spk-band__p">La mayoría de las charlas de IA venden un póster: sostenibilidad, eficiencia, el futuro. Esta arranca en un lugar más útil para una sala de CEOs.</p>
          <p class="cr-spk-band__p pp-mt">El tema es la IA aplicada a decisiones responsables. Decidir con mejor información, menos ruido y una lectura más clara de lo que se pone en juego. El menor costo y la menor carga ambiental son la consecuencia de decidir bien, no el titular. Ese orden importa, y una sala de operadores nota la diferencia de inmediato.</p>
          <p class="cr-spk-band__p pp-mt">No voy a posar de autoridad en ESG y no lo voy a fingir en tarima. Construyo IA y dirijo negocios. Ese es el piso desde el que hablo.</p>
          <p class="cr-spk-band__p pp-mt">Para un grupo de CEOs de resorts dentro de un portafolio de private equity, la charla se puede afinar por uno de estos ángulos, elegido con usted:</p>
          <div class="pp-angles">
            <article class="pp-angle">
              <h3 class="pp-angle__h">La IA como palanca de integración pos-fusión.</h3>
              <p class="pp-angle__p">Dos operaciones que se vuelven una. La IA ayuda a estandarizar decisiones, sacar a la luz lo que cada propiedad ya sabe y cerrar la distancia entre los números de arriba y lo que pasa en el piso.</p>
            </article>
            <article class="pp-angle">
              <h3 class="pp-angle__h">La IA que baja OPEX y protege margen.</h3>
              <p class="pp-angle__p">El idioma que habla un fondo de verdad. Dónde mueve la IA la línea de costo sin tocar la experiencia del huésped, y dónde no.</p>
            </article>
            <article class="pp-angle">
              <h3 class="pp-angle__h">La IA que sigue invisible para el huésped de lujo.</h3>
              <p class="pp-angle__p">En el lujo, la tecnología que se ve es la que falló. Dónde va la IA detrás del telón, y por qué ese es el punto.</p>
            </article>
          </div>
          <p class="cr-spk-band__p pp-mt">Uno de estos, no los tres. Escogemos el que le sirve a su audiencia.</p>
        </div>
      </section>

      <!-- 3. QUIÉN ES CAMILO -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Quién es Camilo</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">La pregunta honesta que hace un bureau:</span> ¿aguanta una sala de 70 CEOs?</h2>
          <p class="cr-spk-band__p">Aquí está la prueba, y es en vivo, no un reel de mejores momentos. Conduzco <strong>Métase en mi cabeza</strong>, programa semanal en televisión nacional (Red+/Claro) con invitados de primer nivel, y <strong>Pertinente</strong>, un podcast diario en solitario. Semanal, frente a cámara, con audiencia. Diario, solo, cargando la hora completa. Eso es dominio de escenario en condiciones reales, cada semana, para que cualquiera lo verifique.</p>
          <p class="cr-spk-band__p pp-mt">El resto del piso desde el que hablo: cofundador y Director LATAM de Navigamo, donde construyo IA, y Director Regional LATAM de The AI Collective. Más de 25 años operando. No comento la IA desde afuera. La construyo y dirijo negocios con ella.</p>
          <p class="pp-video"><a class="cr-btn cr-btn--ghost" href="[link]" data-placeholder>Ver un segmento en vivo [link]</a></p>
        </div>
      </section>

      <!-- 4. LOS TRES TEMAS -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Los tres temas de keynote</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Tres rutas,</span> adaptables a la audiencia y al objetivo.</h2>
          <div class="cr-spk-topics pp-topics">
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">01</div>
              <h3 class="cr-spk-topic__h">Gobernanza de IA</h3>
              <p class="cr-spk-topic__p">Cómo una junta y un C-level deciden qué hace la IA, qué no se le permite hacer y quién responde por eso.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">02</div>
              <h3 class="cr-spk-topic__h">Decisiones corporativas responsables con IA</h3>
              <p class="cr-spk-topic__p">Usar la IA para decidir mejor, con lo que se pone en juego sobre la mesa. Es la que calza natural con el ángulo de sostenibilidad que pide su evento.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">03</div>
              <h3 class="cr-spk-topic__h">Básicos de IA para el C-level</h3>
              <p class="cr-spk-topic__p">Lo que todo ejecutivo necesita entender para liderar la conversación en vez de delegarla a ciegas.</p>
            </article>
          </div>
          <p class="cr-spk-band__p pp-mt">Para esta sala, el tema 2 sería el centro probable, con lo que el formato permita de 1 y 3.</p>
        </div>
      </section>

      <!-- 5. INVERSIÓN -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Inversión</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">USD 8,000</span> por el keynote.</h2>
          <p class="cr-spk-band__p">Lo que eso incluye: una charla construida para esta sala en específico, conversaciones de preparación con usted antes, y un conferencista que puede cargar el bloque principal sin red. Entrega en español o inglés, como usted prefiera.</p>
          <p class="cr-spk-band__p pp-mt">Los viáticos se facturan aparte y los coordina el cliente: vuelos, alojamiento en el Zilara y traslados.</p>
          <p class="cr-spk-band__p pp-mt">Para reservar la fecha, un depósito del 50% la aparta. El saldo se paga el día del evento.</p>
        </div>
      </section>

      <!-- 6. LOGÍSTICA -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Logística</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Los detalles</span> en lo práctico.</h2>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Fecha</div><div class="cr-spk-logi__v">17 o 18 de septiembre, por confirmar.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Sede</div><div class="cr-spk-logi__v">Hotel Zilara, Cancún.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Idioma</div><div class="cr-spk-logi__v">Español o inglés.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Formato</div><div class="cr-spk-logi__v">Keynote principal, cerca de 45 minutos, ajustable a su agenda del día.</div></div>
          </div>
        </div>
      </section>

      <!-- 7. PARA AFINAR -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Para afinar</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Tres preguntas,</span> y las respuestas cambian la charla.</h2>
          <div class="cr-spk-topics pp-topics">
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">01</div>
              <p class="cr-spk-topic__p">Quiénes son los cerca de 70 CEOs. Sector, nivel, un solo portafolio o sala mixta.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">02</div>
              <p class="cr-spk-topic__p">Quién pidió el cruce de IA y sostenibilidad, y por qué. Con qué idea quiere que la sala se vaya.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">03</div>
              <p class="cr-spk-topic__p">Formato, duración y objetivo. Abrir el día, cerrarlo, antes o después de la cena, y qué tiene que pasar después.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- 8. SIGUIENTE PASO (DARK) -->
      <section class="cr-cta-band">
        <div class="cr-container">
          <p class="cr-eyebrow cr-eyebrow--ondark" style="justify-content:center"><span class="cr-franja cr-franja--mag"></span>Siguiente paso</p>
          <h2 class="cr-cta-band__h"><span class="cr-d-thin">Dos</span> caminos.</h2>
          <p class="pp-cta__p">Apartar el 17 o 18 de septiembre con el depósito del 50%, o una llamada de 20 minutos primero, para que yo escuche la sala y usted decida con lo real enfrente.</p>
          <a class="cr-btn cr-btn--accent" href="mailto:camilo@navigamo.co?subject=Keynote%20Canc%C3%BAn%202026">Responda por aquí o escriba a camilo@navigamo.co →</a>
        </div>
      </section>
    </div>
  </main>

  <style>
    /* Propuesta privada — estilos mínimos sobre el DS. Todo apoyado en tokens. */
    .pp-langbar {
      position: sticky; top: 0; z-index: 50;
      background: rgba(244,244,243,0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--hairline);
    }
    .pp-langbar__inner {
      height: var(--header-h);
      display: flex; align-items: center; justify-content: space-between; gap: var(--s-5);
    }
    .pp-brand { font-weight: 700; font-size: var(--h4); letter-spacing: -.02em; color: var(--ink); }
    .pp-lang { display: flex; align-items: center; gap: var(--s-2); }
    .pp-lang__btn {
      font-family: inherit; font-weight: 600; font-size: var(--body);
      letter-spacing: .06em; color: var(--ink-3);
      background: none; border: 0; cursor: pointer; padding: 4px 2px;
      transition: color var(--dur-fast) var(--ease);
    }
    .pp-lang__btn:hover { color: var(--ink); }
    .pp-lang__btn.is-active { color: var(--accent); }
    .pp-lang__sep { color: var(--ink-3); }

    .pp-mt { margin-top: var(--s-4); }

    .pp-angles {
      margin-top: var(--s-6);
      display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-5);
    }
    .pp-angle { border-top: 2px solid var(--accent); padding-top: var(--s-4); }
    .pp-angle__h {
      font-weight: 700; font-size: var(--h4); letter-spacing: var(--tracking-heading);
      line-height: 1.15; margin: 0 0 var(--s-3); color: var(--ink);
    }
    .pp-angle__p { font-size: var(--body); line-height: 1.6; color: var(--ink-2); margin: 0; }

    .pp-topics { margin-top: var(--s-6); }
    .pp-video { margin-top: var(--s-5); }
    .pp-cta__p {
      font-size: var(--body-lg); line-height: 1.6; color: var(--ink-on-dark-2);
      max-width: 52ch; margin: 0 auto var(--s-6);
    }

    @media (max-width: 720px) {
      .pp-angles { grid-template-columns: 1fr; gap: var(--s-4); }
    }
  </style>

  <script is:inline>
    (function () {
      var root = document.querySelector('.pp');
      if (!root) return;
      var buttons = root.querySelectorAll('[data-set-lang]');
      var locales = root.querySelectorAll('[data-locale]');
      function apply(lang) {
        locales.forEach(function (el) { el.hidden = el.getAttribute('data-locale') !== lang; });
        buttons.forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-set-lang') === lang); });
        root.setAttribute('data-lang', lang);
        document.documentElement.lang = lang === 'es' ? 'es-CO' : 'en-US';
      }
      buttons.forEach(function (b) {
        b.addEventListener('click', function () { apply(b.getAttribute('data-set-lang')); });
      });
    })();
  </script>
</Base>
