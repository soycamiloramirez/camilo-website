---
// PROPUESTA PRIVADA - no indexable, no enlazada desde el sitio.
// Ruta no adivinable (sufijo aleatorio). El sitemap excluye /p/ (ver astro.config.mjs).
// Base.astro emite <meta robots noindex,nofollow> con noindex={true}, y en PROD
// carga GA4 (G-YNYELQBZ62) + Microsoft Clarity (wzczzppi54) para grabar la sesión.
// Bilingüe EN/ES con toggle en JS mínimo; default EN.
import Base from '../../layouts/Base.astro';

const lang = 'en' as const;
const pageTitle = 'Keynote proposal · Cancún 2026';
const pageDescription = 'Private proposal.';
---
<Base
  lang={lang}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageType="website"
  path="/p/propuesta-tortuga-cancun-a7c2b0a0"
  hasAlternate={false}
  noindex={true}
>
  <main class="pp" data-lang="en">
    <!-- LANGUAGE TOGGLE -->
    <div class="pp-langbar">
      <div class="cr-container pp-langbar__inner">
        <span class="pp-brand">Camilo Ramírez</span>
        <div class="pp-lang" role="group" aria-label="Language / Idioma">
          <button type="button" class="pp-lang__btn is-active" data-set-lang="en">EN</button>
          <span class="pp-lang__sep">/</span>
          <button type="button" class="pp-lang__btn" data-set-lang="es">ES</button>
        </div>
      </div>
    </div>

    <!-- ================= ENGLISH ================= -->
    <div class="pp-locale" data-locale="en">

      <!-- SHARED HEADER -->
      <section class="cr-pagehead">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Keynote proposal</p>
          <h1 class="cr-pagehead__title"><span class="cr-d-thin">Tortuga Resorts leadership gathering</span> · Hotel Zilara, Cancún · September 17 or 18, 2026</h1>
          <p class="cr-lead cr-pagehead__lead">Prepared for Thynkers Lab (Simone Sztrigler)</p>
        </div>
      </section>

      <!-- ABOUT THIS PROPOSAL -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>About this proposal</p>
          <p class="cr-spk-band__p">Thank you for considering Camilo Ramírez for the Tortuga Resorts leadership gathering. This document lays out the session, the format, the speaker and the terms, so it stands on its own and can be forwarded to the Tortuga team without further context.</p>
        </div>
      </section>

      <!-- THE KEYNOTE -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>The keynote</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Working title:</span> “Deciding when AI is already in the room.”</h2>
          <p class="cr-spk-band__p">AI has already entered the operations of most of these companies, often without leadership deciding it. Teams already analyze, forecast and recommend with models in the loop. So the question for whoever leads is no longer whether to adopt it. The question is how to keep deciding well when part of the analysis reaching your desk has already passed through a machine.</p>
          <p class="cr-spk-band__p pp-mt">The session works on the judgment of the person with the final call: what to delegate to a model and what to keep as your own judgment, how to read a recommendation that arrives polished and self-assured yet unquestioned, and where an organization gains real efficiency versus where it merely automates a mistake faster. Efficiency and sustainability show up as a consequence of deciding better, not as the topic. Camilo builds AI every day; he does not present himself as a sustainability specialist.</p>
          <p class="cr-spk-band__p pp-mt">This is a talk for sitting down to think, not for leaving scared or dazzled.</p>
          <p class="cr-spk-band__p pp-mt"><strong>What the audience leaves with:</strong></p>
          <ul class="pp-list">
            <li class="pp-list__i">A clear framework for telling which decisions to delegate and which to keep.</li>
            <li class="pp-list__i">Practical signals to audit an AI-generated recommendation before signing off on it.</li>
            <li class="pp-list__i">A calm, hype-free read on where the technology actually stands for a leadership team.</li>
          </ul>
        </div>
      </section>

      <!-- FORMAT -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Format</p>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Venue</div><div class="cr-spk-logi__v">In person at the Hotel Zilara.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Duration</div><div class="cr-spk-logi__v">Length and Q&amp;A to be agreed based on the event agenda.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Language</div><div class="cr-spk-logi__v">Available in Spanish or English.</div></div>
          </div>
        </div>
      </section>

      <!-- THE SPEAKER -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>The speaker</p>
          <p class="cr-spk-band__p">Camilo Ramírez is co-founder and LATAM Director of Navigamo, a company that builds AI solutions for business. He is Regional LATAM Director of The AI Collective, the largest AI community in the world. He hosts <strong>Métase en mi cabeza</strong> (national television) and <strong>Pertinente</strong> (a daily podcast on AI and business). More than 25 years translating technology into business decisions. He speaks about AI from building it, not from commenting on it.</p>
        </div>
      </section>

      <!-- INVESTMENT -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Investment</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Keynote fee:</span> USD 8,000.</h2>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Fee</div><div class="cr-spk-logi__v">Keynote fee: USD 8,000.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Travel</div><div class="cr-spk-logi__v">Travel and lodging billed separately, at cost.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Deposit</div><div class="cr-spk-logi__v">50% deposit to hold the date.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Balance</div><div class="cr-spk-logi__v">Balance due before the event.</div></div>
          </div>
          <p class="cr-spk-band__p pp-mt pp-valid">This proposal is valid until July 31, 2026.</p>
        </div>
      </section>

      <!-- TAILORING -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>To tailor the session</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Three things sharpen the talk</span> to the audience.</h2>
          <div class="cr-spk-topics pp-topics">
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">01</div>
              <p class="cr-spk-topic__p">The profile of attendees.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">02</div>
              <p class="cr-spk-topic__p">What they are facing with AI today.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">03</div>
              <p class="cr-spk-topic__p">What the organizer would like them to walk away with.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- NEXT STEPS (DARK) -->
      <section class="cr-cta-band">
        <div class="cr-container">
          <p class="cr-eyebrow cr-eyebrow--ondark" style="justify-content:center"><span class="cr-franja cr-franja--mag"></span>Next steps</p>
          <h2 class="cr-cta-band__h"><span class="cr-d-thin">Three steps</span> forward.</h2>
          <ol class="pp-steps">
            <li class="pp-steps__i">Confirm the date (September 17 or 18).</li>
            <li class="pp-steps__i">Formalize the 50% deposit to hold Camilo's calendar.</li>
            <li class="pp-steps__i">Set a short call to calibrate the angle.</li>
          </ol>
          <p class="pp-cta__p">I remain at your disposal for any detail.<br>Camilo Ramírez</p>

          <form class="pp-form" data-pp-form novalidate>
            <input type="hidden" name="propuesta" value="Tortuga Resorts · Cancún 2026">
            <input type="hidden" name="lang" value="en">
            <div class="pp-form__hp" aria-hidden="true">
              <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <label class="pp-check">
              <input type="checkbox" name="avanzar" value="yes">
              <span>Yes, we would like to move forward.</span>
            </label>
            <label class="pp-field">
              <span class="pp-field__l">Name</span>
              <input type="text" name="nombre" required autocomplete="name">
            </label>
            <label class="pp-field">
              <span class="pp-field__l">Email</span>
              <input type="email" name="email" required autocomplete="email">
            </label>
            <label class="pp-field">
              <span class="pp-field__l">Message</span>
              <textarea name="mensaje" rows="4"></textarea>
            </label>
            <button type="submit" class="cr-btn cr-btn--accent pp-form__submit">Send →</button>
            <p class="pp-form__status" data-pp-status role="status" aria-live="polite" hidden></p>
          </form>
          <p class="pp-cta__alt">or write directly to <a href="mailto:yo@camilo-ramirez.com?subject=Keynote%20Canc%C3%BAn%202026">yo@camilo-ramirez.com</a></p>
        </div>
      </section>
    </div>

    <!-- ================= ESPAÑOL ================= -->
    <div class="pp-locale" data-locale="es" hidden>

      <!-- ENCABEZADO COMPARTIDO -->
      <section class="cr-pagehead">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Propuesta de keynote</p>
          <h1 class="cr-pagehead__title"><span class="cr-d-thin">Encuentro de líderes Tortuga Resorts</span> · Hotel Zilara, Cancún · 17 o 18 de septiembre de 2026</h1>
          <p class="cr-lead cr-pagehead__lead">Preparada para Thynkers Lab (Simone Sztrigler)</p>
        </div>
      </section>

      <!-- SOBRE ESTA PROPUESTA -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Sobre esta propuesta</p>
          <p class="cr-spk-band__p">Gracias por considerar a Camilo Ramírez para el encuentro de líderes de Tortuga Resorts. Este documento describe la sesión, el formato, el conferencista y las condiciones, de modo que se sostenga por sí solo y pueda reenviarse al equipo de Tortuga sin necesidad de contexto adicional.</p>
        </div>
      </section>

      <!-- LA KEYNOTE -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>La keynote</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Título tentativo:</span> “Decidir cuando la IA ya está en la sala.”</h2>
          <p class="cr-spk-band__p">La IA ya entró a la operación de la mayoría de estas empresas, muchas veces sin que la dirección lo decidiera. Los equipos ya analizan, proyectan y recomiendan con modelos de por medio. Entonces la pregunta para quien dirige dejó de ser si adoptarla. La pregunta es cómo seguir decidiendo bien cuando parte del análisis que llega a su escritorio ya pasó por una máquina.</p>
          <p class="cr-spk-band__p pp-mt">La sesión trabaja el criterio de quien tiene la última palabra: qué conviene delegar a un modelo y qué conservar como juicio propio, cómo leer una recomendación que llega pulida y segura de sí misma pero que nadie ha cuestionado, y dónde una organización gana eficiencia real frente a dónde solo automatiza un error más rápido. La eficiencia y la sostenibilidad aparecen como consecuencia de decidir mejor, no como el tema. Camilo construye IA todos los días; no se presenta como especialista en sostenibilidad.</p>
          <p class="cr-spk-band__p pp-mt">Es una charla para sentarse a pensar, no para salir asustado ni deslumbrado.</p>
          <p class="cr-spk-band__p pp-mt"><strong>Lo que la audiencia se lleva:</strong></p>
          <ul class="pp-list">
            <li class="pp-list__i">Un marco claro para distinguir qué decisiones delegar y cuáles conservar.</li>
            <li class="pp-list__i">Señales prácticas para auditar una recomendación generada con IA antes de firmarla.</li>
            <li class="pp-list__i">Una lectura serena, sin exageración ni alarma, de dónde está hoy la tecnología para un comité de dirección.</li>
          </ul>
        </div>
      </section>

      <!-- FORMATO -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Formato</p>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Sede</div><div class="cr-spk-logi__v">Presencial en el Hotel Zilara.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Duración</div><div class="cr-spk-logi__v">Duración y espacio de Q&amp;A a acordar según la agenda del encuentro.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Idioma</div><div class="cr-spk-logi__v">Disponible en español o inglés.</div></div>
          </div>
        </div>
      </section>

      <!-- EL CONFERENCISTA -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>El conferencista</p>
          <p class="cr-spk-band__p">Camilo Ramírez es cofundador y Director LATAM de Navigamo, empresa que construye soluciones de IA para negocios. Es Director Regional LATAM de The AI Collective, la comunidad de IA más grande del mundo. Conduce <strong>Métase en mi cabeza</strong> (televisión nacional) y <strong>Pertinente</strong> (podcast diario sobre IA y negocios). Más de 25 años traduciendo tecnología a decisiones de negocio. Habla de IA desde construirla, no desde comentarla.</p>
        </div>
      </section>

      <!-- INVERSIÓN -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Inversión</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Honorario de la keynote:</span> USD 8,000.</h2>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Honorario</div><div class="cr-spk-logi__v">Honorario de la keynote: USD 8,000.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Viáticos</div><div class="cr-spk-logi__v">Viáticos y hospedaje aparte, facturados al costo.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Depósito</div><div class="cr-spk-logi__v">Depósito del 50% para reservar la fecha.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Saldo</div><div class="cr-spk-logi__v">Saldo antes del evento.</div></div>
          </div>
          <p class="cr-spk-band__p pp-mt pp-valid">Esta propuesta es válida hasta el 31 de julio de 2026.</p>
        </div>
      </section>

      <!-- PARA AFINAR LA SESIÓN -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Para afinar la sesión</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Con tres datos la charla</span> se ajusta al público.</h2>
          <div class="cr-spk-topics pp-topics">
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">01</div>
              <p class="cr-spk-topic__p">El perfil de los asistentes.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">02</div>
              <p class="cr-spk-topic__p">Qué están enfrentando hoy con la IA.</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">03</div>
              <p class="cr-spk-topic__p">Qué le gustaría al organizador que se llevaran de la sala.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- SIGUIENTES PASOS (DARK) -->
      <section class="cr-cta-band">
        <div class="cr-container">
          <p class="cr-eyebrow cr-eyebrow--ondark" style="justify-content:center"><span class="cr-franja cr-franja--mag"></span>Siguientes pasos</p>
          <h2 class="cr-cta-band__h"><span class="cr-d-thin">Tres pasos</span> para avanzar.</h2>
          <ol class="pp-steps">
            <li class="pp-steps__i">Confirmar fecha (17 o 18 de septiembre).</li>
            <li class="pp-steps__i">Formalizar el depósito del 50% para reservar la agenda de Camilo.</li>
            <li class="pp-steps__i">Agendar una llamada breve para calibrar el enfoque.</li>
          </ol>
          <p class="pp-cta__p">Quedo atento para resolver cualquier detalle.<br>Camilo Ramírez</p>

          <form class="pp-form" data-pp-form novalidate>
            <input type="hidden" name="propuesta" value="Tortuga Resorts · Cancún 2026">
            <input type="hidden" name="lang" value="es">
            <div class="pp-form__hp" aria-hidden="true">
              <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <label class="pp-check">
              <input type="checkbox" name="avanzar" value="yes">
              <span>Sí, queremos avanzar.</span>
            </label>
            <label class="pp-field">
              <span class="pp-field__l">Nombre</span>
              <input type="text" name="nombre" required autocomplete="name">
            </label>
            <label class="pp-field">
              <span class="pp-field__l">Correo</span>
              <input type="email" name="email" required autocomplete="email">
            </label>
            <label class="pp-field">
              <span class="pp-field__l">Mensaje</span>
              <textarea name="mensaje" rows="4"></textarea>
            </label>
            <button type="submit" class="cr-btn cr-btn--accent pp-form__submit">Enviar →</button>
            <p class="pp-form__status" data-pp-status role="status" aria-live="polite" hidden></p>
          </form>
          <p class="pp-cta__alt">o escribe directo a <a href="mailto:yo@camilo-ramirez.com?subject=Keynote%20Canc%C3%BAn%202026">yo@camilo-ramirez.com</a></p>
        </div>
      </section>
    </div>
  </main>

  <style>
    /* Propuesta privada - estilos minimos sobre el DS. Todo apoyado en tokens. */
    .pp-langbar {
      position: sticky; top: 0; z-index: 50;
      background: rgba(244,244,243,0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--hairline);
    }
    .pp-langbar__inner {
      height: var(--header-h);
      display: flex; align-items: center; justify-content: space-between; gap: var(--s-5);
    }
    .pp-brand { font-weight: 700; font-size: var(--h4); letter-spacing: -.02em; color: var(--ink); }
    .pp-lang { display: flex; align-items: center; gap: var(--s-2); }
    .pp-lang__btn {
      font-family: inherit; font-weight: 600; font-size: var(--body);
      letter-spacing: .06em; color: var(--ink-3);
      background: none; border: 0; cursor: pointer; padding: 4px 2px;
      transition: color var(--dur-fast) var(--ease);
    }
    .pp-lang__btn:hover { color: var(--ink); }
    .pp-lang__btn.is-active { color: var(--accent); }
    .pp-lang__sep { color: var(--ink-3); }

    .pp-mt { margin-top: var(--s-4); }

    .pp-list {
      list-style: none; padding: 0; margin: var(--s-4) 0 0; max-width: 60ch;
    }
    .pp-list__i {
      position: relative; padding-left: var(--s-5);
      font-size: var(--body-lg); line-height: 1.6; color: var(--ink-2);
      margin-bottom: var(--s-3);
    }
    .pp-list__i::before {
      content: ""; position: absolute; left: 0; top: .6em;
      width: 8px; height: 2px; background: var(--accent);
    }

    .pp-topics { margin-top: var(--s-6); }

    .pp-steps {
      list-style: none; counter-reset: pp; padding: 0;
      max-width: 52ch; margin: 0 auto var(--s-6); text-align: left;
    }
    .pp-steps__i {
      counter-increment: pp;
      position: relative; padding-left: var(--s-6);
      font-size: var(--body-lg); line-height: 1.6; color: var(--ink-on-dark-2);
      margin-bottom: var(--s-3);
    }
    .pp-steps__i::before {
      content: counter(pp);
      position: absolute; left: 0; top: 0;
      font-weight: 700; color: var(--accent);
    }

    .pp-cta__p {
      font-size: var(--body-lg); line-height: 1.6; color: var(--ink-on-dark-2);
      max-width: 52ch; margin: 0 auto var(--s-6);
    }

    .pp-valid {
      font-weight: 600; color: var(--ink); font-size: var(--body);
      border-top: 1px solid var(--hairline); padding-top: var(--s-4);
    }

    /* Closing form */
    .pp-form {
      max-width: 52ch; margin: 0 auto; text-align: left;
      display: flex; flex-direction: column; gap: var(--s-4);
    }
    .pp-form__hp {
      position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;
    }
    .pp-check {
      display: flex; align-items: flex-start; gap: var(--s-3);
      font-size: var(--body-lg); line-height: 1.5; color: var(--ink-on-dark);
      cursor: pointer;
    }
    .pp-check input { margin-top: .35em; width: 18px; height: 18px; accent-color: var(--accent); flex: none; }
    .pp-field { display: flex; flex-direction: column; gap: var(--s-2); }
    .pp-field__l {
      font-size: var(--body); font-weight: 600; letter-spacing: .02em;
      color: var(--ink-on-dark-2);
    }
    .pp-field input,
    .pp-field textarea {
      font-family: inherit; font-size: var(--body-lg); color: var(--ink);
      background: var(--paper, #fff); border: 1px solid var(--hairline);
      border-radius: 6px; padding: 12px 14px; width: 100%;
    }
    .pp-field textarea { resize: vertical; min-height: 96px; }
    .pp-field input:focus,
    .pp-field textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    .pp-form__submit { margin-top: var(--s-2); align-self: flex-start; }
    .pp-form__submit[disabled] { opacity: .6; cursor: default; }
    .pp-form__status {
      font-size: var(--body); line-height: 1.5; color: var(--ink-on-dark-2); margin: 0;
    }
    .pp-form__status.is-err { color: #ffb4b4; }
    .pp-cta__alt {
      font-size: var(--body); line-height: 1.6; color: var(--ink-on-dark-2);
      max-width: 52ch; margin: var(--s-4) auto 0; text-align: center;
    }
    .pp-cta__alt a { color: var(--ink-on-dark); text-decoration: underline; }

    @media (max-width: 720px) {
      .cr-spk-logi { display: block; }
    }
  </style>

  <script is:inline>
    (function () {
      var root = document.querySelector('.pp');
      if (!root) return;
      var buttons = root.querySelectorAll('[data-set-lang]');
      var locales = root.querySelectorAll('[data-locale]');
      function apply(lang) {
        locales.forEach(function (el) { el.hidden = el.getAttribute('data-locale') !== lang; });
        buttons.forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-set-lang') === lang); });
        root.setAttribute('data-lang', lang);
        document.documentElement.lang = lang === 'es' ? 'es-CO' : 'en-US';
      }
      buttons.forEach(function (b) {
        b.addEventListener('click', function () { apply(b.getAttribute('data-set-lang')); });
      });

      // Closing forms (one per locale). Submit via fetch to /api/propuesta.
      var forms = root.querySelectorAll('[data-pp-form]');
      forms.forEach(function (form) {
        var status = form.querySelector('[data-pp-status]');
        var submit = form.querySelector('.pp-form__submit');
        var isEs = form.querySelector('input[name="lang"]') &&
          form.querySelector('input[name="lang"]').value === 'es';
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (status) { status.hidden = false; status.classList.remove('is-err'); }
          if (!form.checkValidity()) {
            if (status) { status.classList.add('is-err'); status.textContent = isEs ? 'Revisa el nombre y el correo.' : 'Please check your name and email.'; }
            form.reportValidity();
            return;
          }
          if (submit) { submit.disabled = true; }
          if (status) { status.textContent = isEs ? 'Enviando…' : 'Sending…'; }
          var fd = new FormData(form);
          fetch('/api/propuesta', { method: 'POST', body: fd })
            .then(function (r) { return r.json().catch(function () { return { ok: r.ok }; }); })
            .then(function (res) {
              if (res && res.ok) {
                try {
                  if (typeof window.gtag === 'function') {
                    window.gtag('event', 'propuesta_submit', { lang: isEs ? 'es' : 'en' });
                  }
                } catch (err) {}
                form.reset();
                if (status) { status.textContent = isEs ? 'Gracias. Recibí tu respuesta y te escribo pronto.' : 'Thank you. I received your reply and will be in touch shortly.'; }
                if (submit) { submit.remove(); }
              } else {
                if (submit) { submit.disabled = false; }
                if (status) { status.classList.add('is-err'); status.textContent = isEs ? 'No se pudo enviar. Escribe directo a yo@camilo-ramirez.com.' : 'Could not send. Please write directly to yo@camilo-ramirez.com.'; }
              }
            })
            .catch(function () {
              if (submit) { submit.disabled = false; }
              if (status) { status.classList.add('is-err'); status.textContent = isEs ? 'No se pudo enviar. Escribe directo a yo@camilo-ramirez.com.' : 'Could not send. Please write directly to yo@camilo-ramirez.com.'; }
            });
        });
      });
    })();
  </script>
</Base>
