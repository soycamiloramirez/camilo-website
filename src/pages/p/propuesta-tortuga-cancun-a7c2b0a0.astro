---
// PROPUESTA PRIVADA — no indexable, no enlazada desde el sitio.
// Ruta no adivinable (sufijo aleatorio). El sitemap excluye /p/ (ver astro.config.mjs).
// Base.astro emite <meta robots noindex,nofollow> con noindex={true}, y en PROD
// carga GA4 (G-YNYELQBZ62) + Microsoft Clarity (wzczzppi54) para grabar la sesión.
// Bilingüe EN/ES con toggle en JS mínimo; default EN.
import Base from '../../layouts/Base.astro';

const lang = 'en' as const;
const pageTitle = 'Keynote proposal · Cancún 2026';
const pageDescription = 'Private proposal.';
---
<Base
  lang={lang}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageType="website"
  path="/p/propuesta-tortuga-cancun-a7c2b0a0"
  hasAlternate={false}
  noindex={true}
>
  <main class="pp" data-lang="en">
    <!-- LANGUAGE TOGGLE -->
    <div class="pp-langbar">
      <div class="cr-container pp-langbar__inner">
        <span class="pp-brand">Camilo Ramírez</span>
        <div class="pp-lang" role="group" aria-label="Language / Idioma">
          <button type="button" class="pp-lang__btn is-active" data-set-lang="en">EN</button>
          <span class="pp-lang__sep">/</span>
          <button type="button" class="pp-lang__btn" data-set-lang="es">ES</button>
        </div>
      </div>
    </div>

    <!-- ================= ENGLISH ================= -->
    <div class="pp-locale" data-locale="en">

      <!-- SHARED HEADER -->
      <section class="cr-pagehead">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Keynote proposal / Propuesta de keynote</p>
          <h1 class="cr-pagehead__title"><span class="cr-d-thin">Tortuga Resorts: Encuentro ejecutivo</span> — Hotel Zilara, Cancún · 17 o 18 de septiembre de 2026</h1>
          <p class="cr-lead cr-pagehead__lead">Prepared for Thynkers Lab (Simone Sztrigler) / Preparada para Thynkers Lab (Simone Sztrigler)</p>
        </div>
      </section>

      <!-- OPENING -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Opening</p>
          <p class="cr-spk-band__p">Thank you for considering this keynote for the Tortuga Resorts executive gathering. This document lays out the proposed session, its format, the speaker, and the terms, so it can be reviewed on its own by anyone on the Tortuga Resorts team.</p>
          <p class="cr-spk-band__p pp-mt">The audience is a room of leaders. The session is built for them: not a demonstration of tools, but a working session on how they decide.</p>
        </div>
      </section>

      <!-- THE KEYNOTE -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>The keynote</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Working title:</span> “Deciding when AI is already in the room.”</h2>
          <p class="cr-spk-band__p">Artificial intelligence has stopped being a subject for a separate meeting. It is already present in how teams analyze, draft, forecast, and recommend. The question for a leadership team is no longer whether to adopt it, but how to keep deciding well when it is part of every input that reaches the table.</p>
          <p class="cr-spk-band__p pp-mt">This keynote addresses that question directly. It is not a tour of applications or a catalog of products. It looks at the judgment of the person in charge: what to delegate to a model and what to keep, how to read an answer that arrives already polished, where the human criterion still sets the direction.</p>
          <p class="cr-spk-band__p pp-mt">Efficiency and sustainability appear here as consequences, not as the headline. When a leadership team decides well, it spends less, wastes less, and builds operations that hold over time. The session treats good decision-making as the cause and those results as what follows.</p>
          <p class="cr-spk-band__p pp-mt">The audience leaves with a clearer way to think about their own role in an organization where AI is already at work.</p>
        </div>
      </section>

      <!-- FORMAT -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Format</p>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Venue</div><div class="cr-spk-logi__v">In-person keynote at the Hotel Zilara, Cancún.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Duration</div><div class="cr-spk-logi__v">Duration and Q&amp;A to be agreed with the organizer.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Language</div><div class="cr-spk-logi__v">Delivered in Spanish or English, at Tortuga Resorts' preference.</div></div>
          </div>
        </div>
      </section>

      <!-- THE SPEAKER -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>The speaker</p>
          <p class="cr-spk-band__p">Camilo Ramírez is co-founder and LATAM Director of Navigamo, a company that builds AI solutions. He is Regional LATAM Director of The AI Collective. He hosts <strong>Métase en mi cabeza</strong> on national television and <strong>Pertinente</strong>, a daily podcast. He brings more than 25 years of business experience, with a focus on translating artificial intelligence into decisions that leaders can act on.</p>
        </div>
      </section>

      <!-- INVESTMENT -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Investment</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Keynote fee:</span> USD 8,000.</h2>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Fee</div><div class="cr-spk-logi__v">Keynote fee: USD 8,000.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Travel</div><div class="cr-spk-logi__v">Travel and lodging: billed separately, at cost.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Deposit</div><div class="cr-spk-logi__v">50% deposit to confirm the date.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Balance</div><div class="cr-spk-logi__v">Balance due before the event.</div></div>
          </div>
        </div>
      </section>

      <!-- TAILORING -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Tailoring</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">To adjust the session to this specific room,</span> three questions.</h2>
          <div class="cr-spk-topics pp-topics">
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">01</div>
              <p class="cr-spk-topic__p">What is the profile of the audience, in roles and seniority?</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">02</div>
              <p class="cr-spk-topic__p">What are their current challenges with AI, as the organization sees them today?</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">03</div>
              <p class="cr-spk-topic__p">What does the organizer want executives to take away from the session?</p>
            </article>
          </div>
        </div>
      </section>

      <!-- NEXT STEPS (DARK) -->
      <section class="cr-cta-band">
        <div class="cr-container">
          <p class="cr-eyebrow cr-eyebrow--ondark" style="justify-content:center"><span class="cr-franja cr-franja--mag"></span>Next steps</p>
          <h2 class="cr-cta-band__h"><span class="cr-d-thin">Three steps</span> forward.</h2>
          <ol class="pp-steps">
            <li class="pp-steps__i">Confirm the date (17 or 18 September 2026).</li>
            <li class="pp-steps__i">Process the 50% deposit to hold it.</li>
            <li class="pp-steps__i">A short call to align on the three questions above.</li>
          </ol>
          <p class="pp-cta__p">I would be glad to move forward whenever Tortuga Resorts and Thynkers Lab are ready.<br>Camilo Ramírez</p>
          <a class="cr-btn cr-btn--accent" href="mailto:camilo@navigamo.co?subject=Keynote%20Canc%C3%BAn%202026">Reply here or write to camilo@navigamo.co →</a>
        </div>
      </section>
    </div>

    <!-- ================= ESPAÑOL ================= -->
    <div class="pp-locale" data-locale="es" hidden>

      <!-- ENCABEZADO COMPARTIDO -->
      <section class="cr-pagehead">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Keynote proposal / Propuesta de keynote</p>
          <h1 class="cr-pagehead__title"><span class="cr-d-thin">Tortuga Resorts: Encuentro ejecutivo</span> — Hotel Zilara, Cancún · 17 o 18 de septiembre de 2026</h1>
          <p class="cr-lead cr-pagehead__lead">Prepared for Thynkers Lab (Simone Sztrigler) / Preparada para Thynkers Lab (Simone Sztrigler)</p>
        </div>
      </section>

      <!-- APERTURA -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Apertura</p>
          <p class="cr-spk-band__p">Gracias por considerar esta keynote para el encuentro ejecutivo de Tortuga Resorts. Este documento presenta la sesión propuesta, su formato, el conferencista y las condiciones, de modo que pueda revisarse por sí solo, sin depender de correos previos, por cualquier persona del equipo de Tortuga Resorts.</p>
          <p class="cr-spk-band__p pp-mt">La audiencia es una sala de líderes. La sesión está pensada para ellos: no una demostración de herramientas, sino una sesión de trabajo sobre cómo deciden.</p>
        </div>
      </section>

      <!-- LA KEYNOTE -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>La keynote</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Título tentativo:</span> “Decidir cuando la IA ya está en la sala.”</h2>
          <p class="cr-spk-band__p">La inteligencia artificial dejó de ser tema de una reunión aparte. Ya está presente en cómo los equipos analizan, redactan, proyectan y recomiendan. Para un equipo directivo la pregunta ya no es si adoptarla, sino cómo seguir decidiendo bien cuando forma parte de casi todo lo que llega a la mesa.</p>
          <p class="cr-spk-band__p pp-mt">Esta keynote aborda esa pregunta de frente. No es un recorrido de aplicaciones ni un catálogo de productos. Se ocupa del criterio de quien dirige: qué delegar a un modelo y qué conservar, cómo leer una respuesta que llega ya pulida, dónde el criterio humano sigue marcando el rumbo.</p>
          <p class="cr-spk-band__p pp-mt">La eficiencia y la sostenibilidad aparecen como consecuencia, no como el titular. Cuando un equipo directivo decide bien, gasta menos, desperdicia menos y construye operaciones que se sostienen en el tiempo. La sesión trata el decidir bien como la causa, y esos resultados como lo que viene después.</p>
          <p class="cr-spk-band__p pp-mt">La audiencia sale con una manera más clara de pensar su propio rol en una organización donde la IA ya está trabajando.</p>
        </div>
      </section>

      <!-- FORMATO -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Formato</p>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Sede</div><div class="cr-spk-logi__v">Keynote presencial en el Hotel Zilara, Cancún.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Duración</div><div class="cr-spk-logi__v">Duración y Q&amp;A a acordar con el organizador.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Idioma</div><div class="cr-spk-logi__v">En español o inglés, según prefiera Tortuga Resorts.</div></div>
          </div>
        </div>
      </section>

      <!-- EL SPEAKER -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>El speaker</p>
          <p class="cr-spk-band__p">Camilo Ramírez es cofundador y Director LATAM de Navigamo, empresa que construye soluciones de IA. Es Director Regional LATAM de The AI Collective. Conduce <strong>Métase en mi cabeza</strong> en televisión nacional y <strong>Pertinente</strong>, un podcast diario. Suma más de 25 años de experiencia en negocios, con foco en traducir la inteligencia artificial a decisiones sobre las que un líder puede actuar.</p>
        </div>
      </section>

      <!-- INVERSIÓN -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Inversión</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Honorario de keynote:</span> USD 8,000.</h2>
          <div class="cr-spk-logi">
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Honorario</div><div class="cr-spk-logi__v">Honorario de keynote: USD 8,000.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Viáticos</div><div class="cr-spk-logi__v">Viáticos y hospedaje: aparte, al costo.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Depósito</div><div class="cr-spk-logi__v">Depósito del 50% para confirmar la fecha.</div></div>
            <div class="cr-spk-logi__row"><div class="cr-spk-logi__k">Saldo</div><div class="cr-spk-logi__v">Saldo antes del evento.</div></div>
          </div>
        </div>
      </section>

      <!-- PARA AFINAR -->
      <section class="cr-spk-band">
        <div class="cr-container">
          <p class="cr-eyebrow"><span class="cr-franja"></span>Para afinar</p>
          <h2 class="cr-spk-band__h"><span class="cr-d-thin">Para ajustar la sesión a esta sala en particular,</span> tres preguntas.</h2>
          <div class="cr-spk-topics pp-topics">
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">01</div>
              <p class="cr-spk-topic__p">¿Cuál es el perfil de la audiencia, en roles y nivel de responsabilidad?</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">02</div>
              <p class="cr-spk-topic__p">¿Cuáles son sus retos actuales frente a la IA, tal como los ve hoy la organización?</p>
            </article>
            <article class="cr-spk-topic">
              <div class="cr-spk-topic__n">03</div>
              <p class="cr-spk-topic__p">¿Qué quiere el organizador que los ejecutivos se lleven de la sesión?</p>
            </article>
          </div>
        </div>
      </section>

      <!-- SIGUIENTES PASOS (DARK) -->
      <section class="cr-cta-band">
        <div class="cr-container">
          <p class="cr-eyebrow cr-eyebrow--ondark" style="justify-content:center"><span class="cr-franja cr-franja--mag"></span>Siguientes pasos</p>
          <h2 class="cr-cta-band__h"><span class="cr-d-thin">Tres pasos</span> para avanzar.</h2>
          <ol class="pp-steps">
            <li class="pp-steps__i">Confirmar la fecha (17 o 18 de septiembre de 2026).</li>
            <li class="pp-steps__i">Procesar el depósito del 50% para reservarla.</li>
            <li class="pp-steps__i">Una llamada breve para alinear las tres preguntas anteriores.</li>
          </ol>
          <p class="pp-cta__p">Quedo a disposición para avanzar cuando Tortuga Resorts y Thynkers Lab lo consideren.<br>Camilo Ramírez</p>
          <a class="cr-btn cr-btn--accent" href="mailto:camilo@navigamo.co?subject=Keynote%20Canc%C3%BAn%202026">Responda por aquí o escriba a camilo@navigamo.co →</a>
        </div>
      </section>
    </div>
  </main>

  <style>
    /* Propuesta privada — estilos mínimos sobre el DS. Todo apoyado en tokens. */
    .pp-langbar {
      position: sticky; top: 0; z-index: 50;
      background: rgba(244,244,243,0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--hairline);
    }
    .pp-langbar__inner {
      height: var(--header-h);
      display: flex; align-items: center; justify-content: space-between; gap: var(--s-5);
    }
    .pp-brand { font-weight: 700; font-size: var(--h4); letter-spacing: -.02em; color: var(--ink); }
    .pp-lang { display: flex; align-items: center; gap: var(--s-2); }
    .pp-lang__btn {
      font-family: inherit; font-weight: 600; font-size: var(--body);
      letter-spacing: .06em; color: var(--ink-3);
      background: none; border: 0; cursor: pointer; padding: 4px 2px;
      transition: color var(--dur-fast) var(--ease);
    }
    .pp-lang__btn:hover { color: var(--ink); }
    .pp-lang__btn.is-active { color: var(--accent); }
    .pp-lang__sep { color: var(--ink-3); }

    .pp-mt { margin-top: var(--s-4); }

    .pp-topics { margin-top: var(--s-6); }

    .pp-steps {
      list-style: none; counter-reset: pp; padding: 0;
      max-width: 52ch; margin: 0 auto var(--s-6); text-align: left;
    }
    .pp-steps__i {
      counter-increment: pp;
      position: relative; padding-left: var(--s-6);
      font-size: var(--body-lg); line-height: 1.6; color: var(--ink-on-dark-2);
      margin-bottom: var(--s-3);
    }
    .pp-steps__i::before {
      content: counter(pp);
      position: absolute; left: 0; top: 0;
      font-weight: 700; color: var(--accent);
    }

    .pp-cta__p {
      font-size: var(--body-lg); line-height: 1.6; color: var(--ink-on-dark-2);
      max-width: 52ch; margin: 0 auto var(--s-6);
    }

    @media (max-width: 720px) {
      .cr-spk-logi { display: block; }
    }
  </style>

  <script is:inline>
    (function () {
      var root = document.querySelector('.pp');
      if (!root) return;
      var buttons = root.querySelectorAll('[data-set-lang]');
      var locales = root.querySelectorAll('[data-locale]');
      function apply(lang) {
        locales.forEach(function (el) { el.hidden = el.getAttribute('data-locale') !== lang; });
        buttons.forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-set-lang') === lang); });
        root.setAttribute('data-lang', lang);
        document.documentElement.lang = lang === 'es' ? 'es-CO' : 'en-US';
      }
      buttons.forEach(function (b) {
        b.addEventListener('click', function () { apply(b.getAttribute('data-set-lang')); });
      });
    })();
  </script>
</Base>
