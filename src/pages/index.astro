---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ultimo from '../components/Ultimo.astro';
import UltimoBlog from '../components/UltimoBlog.astro';
import Tesis from '../components/Tesis.astro';
import Trabajo from '../components/Trabajo.astro';
import Roles from '../components/Roles.astro';
import TrayectoriaBrief from '../components/TrayectoriaBrief.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { SITE, PODCASTS } from '../content/copy';

const lang = 'es' as const;

const extraJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'es-CO',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: 'Pertinente',
    description:
      'Podcast diario, ~10 minutos, sobre IA, negocios y geopolítica en LATAM. Camilo Ramírez en solitario analizando un tema clave cada día, para líderes que necesitan entender hacia dónde va el dinero y la innovación.',
    url: PODCASTS.pertinente.platforms[0].href,
    webFeed: `https://itunes.apple.com/lookup?id=${PODCASTS.pertinente.appleId}`,
    inLanguage: 'es',
    author: { '@type': 'Person', name: 'Camilo Ramírez', url: SITE.url },
    sameAs: PODCASTS.pertinente.platforms.map((p) => p.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: 'Métase en mi cabeza',
    description:
      'Conversaciones semanales con líderes que construyen el presente y el futuro de Latinoamérica. IA con visión humana, no técnica. Producido por Navigamo, Got-It TV y AT Medios.',
    url: PODCASTS.memc.platforms[0].href,
    inLanguage: 'es',
    author: { '@type': 'Person', name: 'Camilo Ramírez', url: SITE.url },
    sameAs: PODCASTS.memc.platforms.map((p) => p.href),
  },
];
---
<Base lang={lang} path="/" extraJsonLd={extraJsonLd}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Roles lang={lang} />
    <Ultimo lang={lang} />
    <UltimoBlog />
    <Tesis lang={lang} />
    <Trabajo lang={lang} />
    <TrayectoriaBrief lang={lang} />
    <Contacto lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
