---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COPY, SITE, PODCASTS, AIC_PARTNERS } from '../content/copy';

const lang = 'es' as const;
const t = COPY.es;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const extraJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'es-CO',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: 'Pertinente',
    description: t.ultimo.pertinente.oneLine,
    url: PODCASTS.pertinente.platforms[0].href,
    webFeed: `https://itunes.apple.com/lookup?id=${PODCASTS.pertinente.appleId}`,
    inLanguage: 'es',
    author: { '@type': 'Person', name: 'Camilo Ramírez', url: SITE.url },
    sameAs: PODCASTS.pertinente.platforms.map((p) => p.href),
  },
];

function fmtDate(d: Date) {
  return d.toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' });
}
---
<Base lang={lang} path="/" extraJsonLd={extraJsonLd}>
  <Header lang={lang} />

  <main id="top">

    <!-- HERO -->
    <section class="cr-hero">
      <div class="cr-container cr-hero__grid">
        <div class="cr-hero__copy">
          <p class="cr-eyebrow"><span class="cr-franja"></span>{t.hero.eyebrow}</p>
          <h1 class="cr-hero__title">
            <span class="cr-hero__title-thin">Criterio sobre IA,</span><br>
            negocios <span class="cr-hero__amp">y</span> LATAM.<br>
            <span class="cr-hero__title-thin">Publicado todos los días.</span>
          </h1>
          <p class="cr-lead cr-hero__lead">{t.hero.lede}</p>
          <div class="cr-hero__actions">
            <a class="cr-btn cr-btn--accent" href="/pertinente">{t.hero.ctaPrimary}</a>
            <a class="cr-btn cr-btn--link" href="#trabajar">{t.hero.ctaSecondary} →</a>
          </div>
          <p class="cr-hero__foot">{t.hero.since} · {SITE.location.es}</p>
        </div>
        <div class="cr-hero__media">
          <div class="cr-hero__photo" style="background-image:url('/camilo-hero.jpg')" role="img" aria-label="Retrato de Camilo Ramírez"></div>
        </div>
      </div>
    </section>

    <!-- BUILDING (Navigamo + AI Collective + Partners) -->
    <section class="cr-build">
      <div class="cr-container">
        <div class="cr-build__row">
          <div class="cr-build__lead">
            <p class="cr-eyebrow"><span class="cr-franja"></span>{t.navigamo.kicker}</p>
            <img class="cr-build__logo" src="/navigamo-logo.svg" alt="Navigamo">
          </div>
          <div class="cr-build__body">
            <h2 class="cr-build__h">{t.navigamo.title}</h2>
            <p>{t.navigamo.p}</p>
            <p class="cr-build__intro">{t.navigamo.ctaIntro}</p>
            <a class="cr-btn cr-btn--link" href={t.navigamo.href}>{t.navigamo.cta} ↗</a>
          </div>
        </div>

        <div class="cr-build__row">
          <div class="cr-build__lead">
            <p class="cr-eyebrow"><span class="cr-franja"></span>{t.aic.kicker}</p>
            <img class="cr-build__logo" src="/aicollective-logo.svg" alt="The AI Collective">
          </div>
          <div class="cr-build__body">
            <h2 class="cr-build__h">{t.aic.title}</h2>
            <p>{t.aic.p}</p>
            <a class="cr-btn cr-btn--link" href={t.aic.href}>{t.aic.cta} ↗</a>
          </div>
        </div>

        <div class="cr-partners">
          <p class="cr-partners__lbl">{t.aic.partnersLabel}</p>
          <div class="cr-partners__row">
            {AIC_PARTNERS.map((p) => (
              <span class="cr-partner"><img src={`/ds-assets/partners/${p.toLowerCase()}.svg`} alt="">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- LO ÚLTIMO -->
    <section id="ultimo" class="cr-ultimo">
      <div class="cr-container">
        <p class="cr-eyebrow"><span class="cr-franja"></span>{t.ultimo.kicker}</p>
        <h2 class="cr-display-2 cr-ultimo__title"><span class="cr-d-thin">Donde ejerzo el</span> criterio, <span class="cr-d-thin">en público.</span></h2>
        <p class="cr-lead" style="max-width:64ch;margin-bottom:32px">{t.ultimo.lede}</p>

        <div class="cr-ultimo__grid">
          <article class="cr-pod cr-pod--pertinente">
            <div class="cr-pod__art" style="background-image:url('/ds-assets/pertinente-cover.jpg')"></div>
            <div class="cr-pod__body">
              <div class="cr-pod__meta">{t.ultimo.pertinente.tag}</div>
              <h3 class="cr-pod__name">{t.ultimo.pertinente.title}</h3>
              <p class="cr-pod__desc">{t.ultimo.pertinente.oneLine}</p>
              <a class="cr-btn cr-btn--accent cr-pod__cta" href="/pertinente">{t.hero.ctaPrimary}</a>
            </div>
          </article>

          <article class="cr-pod cr-pod--memc">
            <div class="cr-pod__art" style="background-image:url('/ds-assets/memc-banner.png')"></div>
            <div class="cr-pod__body">
              <div class="cr-pod__meta">{t.ultimo.memc.tag}</div>
              <h3 class="cr-pod__name">{t.ultimo.memc.title}</h3>
              <p class="cr-pod__desc">{t.ultimo.memc.oneLine}</p>
              <a class="cr-btn cr-btn--ghost cr-pod__cta" href="/metase">Ver las conversaciones</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- DEL BLOG -->
    <section id="blog" class="cr-blog">
      <div class="cr-container">
        <div class="cr-blog__head">
          <div>
            <p class="cr-eyebrow"><span class="cr-franja"></span>Del blog</p>
            <h2 class="cr-display-2 cr-blog__title"><span class="cr-d-thin">El mismo criterio, en formato</span> <em class="cr-d-em">editorial.</em></h2>
          </div>
          <a class="cr-btn cr-btn--link" href="/blog">Ver todo el blog →</a>
        </div>

        <div class="cr-blog__list">
          {posts.map((post) => (
            <a class="cr-post" href={`/blog/${post.slug}`}>
              <span class="cr-post__cat">{post.data.categories?.[0] ?? 'Blog'}</span>
              <h3 class="cr-post__title">{post.data.title}</h3>
              <span class="cr-post__meta">{fmtDate(post.data.date)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- TESIS (DARK) -->
    <section id="tesis" class="cr-tesis" data-surface="dark">
      <div class="cr-container">
        <p class="cr-eyebrow cr-eyebrow--ondark"><span class="cr-franja cr-franja--mag"></span>{t.tesis.kicker}</p>
        <h2 class="cr-display-2 cr-tesis__title"><span class="cr-d-thin">Tres</span> convicciones <span class="cr-d-thin">que sostienen lo que publico.</span></h2>

        <div class="cr-tesis__grid">
          {t.tesis.items.map((item, i) => (
            <article class="cr-tesis__item">
              <div class="cr-tesis__n">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="cr-tesis__h">{item.h}</h3>
              <p class="cr-tesis__b">{item.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- TRABAJAR CONMIGO -->
    <section id="trabajar" class="cr-work">
      <div class="cr-container">
        <p class="cr-eyebrow"><span class="cr-franja"></span>{t.trabajo.kicker}</p>
        <h2 class="cr-display-2 cr-work__title"><span class="cr-d-thin">Cuando el contenido no basta y necesita</span> <em class="cr-d-em">la sala.</em></h2>

        <div class="cr-work__grid">
          {t.trabajo.cards.map((c) => (
            <article class="cr-work__card">
              <p class="cr-work__ey">{c.tag === 'Advisory' ? 'Para organizaciones' : 'Para eventos'}</p>
              <h3 class="cr-work__h">{c.tag}</h3>
              <p class="cr-work__b">{c.p}</p>
              <div class="cr-work__foot">
                <span class="cr-work__meta">{c.for}</span>
                <a class="cr-btn cr-btn--primary cr-work__cta" href={c.tag === 'Speaking' ? '/speaking' : '#contacto'}>
                  {c.tag === 'Advisory' ? 'Hablemos de su organización' : 'Invitarme a hablar'}
                </a>
              </div>
            </article>
          ))}
        </div>
        <p class="cr-work__note">{t.trabajo.filter}</p>
      </div>
    </section>

    <!-- HISTORIA (5 hitos) -->
    <section id="historia" class="cr-tray">
      <div class="cr-container">
        <p class="cr-eyebrow"><span class="cr-franja"></span>Historia</p>
        <h2 class="cr-display-2 cr-tray__title"><span class="cr-d-thin">Veinte años aprendiendo a leer la</span> estructura <span class="cr-d-thin">de un problema.</span></h2>
        <p class="cr-lead" style="max-width:64ch;margin-bottom:40px">De la televisión a la IA, el oficio cambió, pero el patrón no: ver un problema, construir el sistema que lo resuelve. Cinco capítulos, una sola historia.</p>

        <ol class="cr-tray__list">
          <li class="cr-tray__item">
            <div class="cr-tray__years">1999 — 2010</div>
            <div class="cr-tray__copy"><h3 class="cr-tray__h">Broadcast Design</h3></div>
          </li>
          <li class="cr-tray__item">
            <div class="cr-tray__years">2007 — 2026</div>
            <div class="cr-tray__copy"><h3 class="cr-tray__h">Netbangers</h3></div>
          </li>
          <li class="cr-tray__item">
            <div class="cr-tray__years">2018 — 2023</div>
            <div class="cr-tray__copy"><h3 class="cr-tray__h">Custom Built Show</h3></div>
          </li>
          <li class="cr-tray__item">
            <div class="cr-tray__years">2024 — hoy</div>
            <div class="cr-tray__copy"><h3 class="cr-tray__h">Navigamo · The AI Collective</h3></div>
          </li>
          <li class="cr-tray__item">
            <div class="cr-tray__years">2025 — hoy</div>
            <div class="cr-tray__copy"><h3 class="cr-tray__h">Pertinente · Métase en mi cabeza</h3></div>
          </li>
        </ol>
        <div style="margin-top:40px"><a class="cr-btn cr-btn--link" href="/historia">Leer la historia completa →</a></div>
      </div>
    </section>

    <!-- CONTACTO (DARK) -->
    <section id="contacto" class="cr-contact" data-surface="dark">
      <div class="cr-container cr-contact__inner">
        <div class="cr-contact__lead">
          <p class="cr-eyebrow cr-eyebrow--ondark"><span class="cr-franja cr-franja--mag"></span>{t.contacto.kicker}</p>
          <h2 class="cr-contact__h">{t.contacto.title}</h2>
          <p class="cr-contact__sub">{t.contacto.lede}</p>
          <a class="cr-contact__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>

        <form class="cr-form" id="contactForm" action={`mailto:${SITE.email}`} method="post" enctype="text/plain">
          <div class="cr-form__row">
            <label class="cr-field">
              <span class="cr-field__label">{t.contacto.form.name}</span>
              <input class="cr-field__input" name="nombre" type="text">
            </label>
            <label class="cr-field">
              <span class="cr-field__label">{t.contacto.form.company}</span>
              <input class="cr-field__input" name="empresa" type="text">
            </label>
          </div>
          <div class="cr-field">
            <span class="cr-field__label">{t.contacto.form.type}</span>
            <div class="cr-form__topics" role="radiogroup">
              {t.contacto.form.types.map((typ, i) => (
                <button type="button" class={`cr-form__topic ${i === 0 ? 'is-on' : ''}`} data-need={typ.toLowerCase()}>{typ}</button>
              ))}
            </div>
            <input type="hidden" name="necesita" value={t.contacto.form.types[0].toLowerCase()}>
          </div>
          <label class="cr-field">
            <span class="cr-field__label">{t.contacto.form.message}</span>
            <textarea class="cr-field__input cr-field__textarea" name="contexto" rows="3"></textarea>
          </label>
          <button class="cr-btn cr-btn--accent cr-form__submit" type="submit">{t.contacto.form.send} →</button>
        </form>
      </div>
    </section>

  </main>

  <Footer lang={lang} />

  <script is:inline>
    document.querySelectorAll('.cr-form__topic').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.cr-form__topic').forEach(function (b) { b.classList.remove('is-on'); });
        btn.classList.add('is-on');
        var hidden = document.querySelector('input[name="necesita"]');
        if (hidden) hidden.value = btn.getAttribute('data-need');
      });
    });
  </script>
</Base>
