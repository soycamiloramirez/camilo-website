---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'es' as const;
const status = Astro.url.searchParams.get('status') || 'ok';
const reason = Astro.url.searchParams.get('reason') || '';

const isOk = status === 'ok';
const pageTitle = isOk
  ? 'Suscripción confirmada · Camilo Ramírez'
  : 'No pudimos confirmar la suscripción · Camilo Ramírez';
const pageDescription = isOk
  ? 'Listo. Cada viernes le llega una pieza con criterio.'
  : 'El link de confirmación no funcionó. Puede intentar de nuevo.';
---

<Base lang={lang} pageTitle={pageTitle} pageDescription={pageDescription} pageType="website" path="/gracias-newsletter" hasAlternate={false} noindex={true}>
  <Header lang={lang} />
  <main>
    <section class="cr-pagehead">
      <div class="cr-container">
        {isOk ? (
          <>
            <p class="cr-eyebrow"><span class="cr-franja"></span>Suscripción confirmada · Carta del viernes</p>
            <h1 class="cr-pagehead__title"><span class="cr-d-thin">Gracias.</span> Quedó dentro.</h1>
            <p class="cr-lead cr-pagehead__lead">Le acabo de mandar un correo de bienvenida con tres temas para abrir cuando quiera. El próximo viernes empieza el ritmo: una pieza editorial, destilada de la semana en IA, negocios y LATAM.</p>
            <p class="cr-lead cr-pagehead__lead" style="margin-top:var(--s-4);color:var(--ink-2)">Mientras tanto, si quiere explorar, en el blog están los análisis recientes.</p>
            <div style="margin-top:var(--s-7);display:flex;flex-wrap:wrap;gap:12px">
              <a class="cr-btn cr-btn--accent" href="/blog">Ir al blog →</a>
              <a class="cr-btn cr-btn--ghost" href="/">Volver al inicio</a>
            </div>
            <p style="margin-top:var(--s-7);font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:18px;color:var(--ink)">Camilo</p>
          </>
        ) : (
          <>
            <p class="cr-eyebrow"><span class="cr-franja"></span>No pude confirmarlo</p>
            <h1 class="cr-pagehead__title"><span class="cr-d-thin">Este link</span> ya no funciona.</h1>
            <p class="cr-lead cr-pagehead__lead">{reason === 'expired'
              ? 'El link vencía a las 24 horas y ya pasó ese plazo. Suscríbase de nuevo y le mando uno fresco al mismo correo.'
              : 'El link puede estar incompleto, o algo del lado nuestro cambió. Suscríbase de nuevo desde la página del boletín y se manda otro link.'}</p>
            <div style="margin-top:var(--s-7);display:flex;flex-wrap:wrap;gap:12px">
              <a class="cr-btn cr-btn--accent" href="/newsletter">Suscribirse de nuevo →</a>
              <a class="cr-btn cr-btn--ghost" href="/">Volver al inicio</a>
            </div>
          </>
        )}
      </div>
    </section>
  </main>
  <Footer lang={lang} />

  {/* GA4 conversion event: solo dispara cuando la confirmación fue exitosa (status=ok).
      Inline + check window.gtag para soportar load asincrono del script de GA4. */}
  <script is:inline define:vars={{ isOk }}>
    if (isOk) {
      function fire() {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'newsletter_confirmed', {
            event_category: 'newsletter',
            event_label: 'doi_complete',
          });
        }
      }
      if (typeof window.gtag === 'function') fire();
      else window.addEventListener('load', fire, { once: true });
    }
  </script>
</Base>
