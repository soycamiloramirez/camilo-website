---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../content/copy';
import {
  PODCAST_ENTRIES,
  PODCAST_SECTIONS,
  PODCAST_TAGS,
  type PodcastSection,
  type PodcastTag,
} from '../content/podcasts';

const lang = 'es' as const;

const pageTitle = 'Podcasts · Camilo Ramírez · curaduría de IA, negocios y vida';
const pageDescription = 'Lo que publico (Pertinente y Métase en mi cabeza) y los podcasts que escucho. Curaduría personal de IA, negocios, geopolítica, ciencia y filosofía, navegable por categoría.';

const extraJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Podcasts · Camilo Ramírez',
    description: pageDescription,
    url: `${SITE.url}/podcasts`,
    inLanguage: 'es-CO',
  },
];

// Mine first (manually rendered as mediacards). The rest agrupados por tag.
const mineEntries = PODCAST_ENTRIES.filter((p) => p.section === 'mine');
const negociosEntries = PODCAST_ENTRIES.filter((p) => p.section === 'negocios');
const fueraEntries = PODCAST_ENTRIES.filter((p) => p.section === 'fuera');

// Color spectrum por tag (purple → magenta → red → orange para distinguir grupos)
const TAG_COLORS: Record<PodcastTag, string> = {
  'ia-tech':         '#800080',
  estrategia:        '#9B1C70',
  ventas:            '#B33067',
  inversion:         '#C84260',
  'alto-rendimiento':'#D55256',
  geopolitica:       '#B33067',
  historia:          '#9B5BBF',
  ciencia:           '#5DA9C9',
  psicologia:        '#3D8B6E',
  espiritualidad:    '#6B7280',
  cultura:           '#A06A2A',
};

// Lucide-like icon mark (small SVG inline) for each tag
function tagIcon(_: PodcastTag) {
  // simple square + dot mark, color via currentColor (--cat)
  return `<svg class="cr-pcat__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/></svg>`;
}

// Agrupa entries por tag dentro de una sección, devolviendo arr ordenado por orden de PODCAST_TAGS
function groupByTag(entries: typeof PODCAST_ENTRIES, sec: PodcastSection) {
  const tags = Object.entries(PODCAST_TAGS).filter(([, v]) => v.section === sec) as [PodcastTag, typeof PODCAST_TAGS[PodcastTag]][];
  return tags
    .map(([tag, info]) => ({ tag, info, items: entries.filter((e) => e.tag === tag) }))
    .filter((g) => g.items.length > 0);
}

const negociosGroups = groupByTag(negociosEntries, 'negocios');
const fueraGroups = groupByTag(fueraEntries, 'fuera');

// Chips: Todos + 11 tags en orden de definición
const chips: { slug: string; label: string }[] = [
  { slug: 'todos', label: 'Todos' },
  ...Object.entries(PODCAST_TAGS).map(([slug, info]) => ({ slug, label: info.label })),
];

function platformLinks(p: typeof PODCAST_ENTRIES[number]) {
  const items: { label: string; href: string }[] = [];
  if (p.spotify) items.push({ label: 'Spotify', href: p.spotify });
  if (p.youtube) items.push({ label: 'YouTube', href: p.youtube });
  if (p.apple) items.push({ label: 'Apple', href: p.apple });
  if (p.amazon) items.push({ label: 'Amazon', href: p.amazon });
  if (p.web) items.push({ label: 'Web', href: p.web });
  return items;
}
---
<Base lang={lang} pageTitle={pageTitle} pageDescription={pageDescription} pageType="website" path="/podcasts" extraJsonLd={extraJsonLd}>
  <Header lang={lang} />

  <main>
    <section class="cr-pagehead">
      <div class="cr-container">
        <p class="cr-eyebrow"><span class="cr-franja"></span>Podcasts</p>
        <h1 class="cr-pagehead__title"><span class="cr-d-thin">Lo que publico y</span> lo que escucho.</h1>
        <p class="cr-lead cr-pagehead__lead">Curaduría personal, no lista pasiva. {PODCAST_ENTRIES.length} podcasts en total. Arriba los míos. Abajo todo agrupado por categoría para que pueda saltar al tema que le interesa.</p>
      </div>
    </section>

    <div class="cr-pchips-wrap">
      <div class="cr-container">
        <nav class="cr-pchips" aria-label="Filtrar por categoría">
          {chips.map((c, i) => (
            <button class={`cr-pchip ${i === 0 ? 'is-on' : ''}`} data-filter={c.slug} type="button">{c.label}</button>
          ))}
        </nav>
      </div>
    </div>

    <!-- MIS PODCASTS -->
    <section id="mis-podcasts" class="cr-blogix">
      <div class="cr-container">
        <p class="cr-eyebrow"><span class="cr-franja"></span>{PODCAST_SECTIONS.mine.kicker}</p>
        <h2 class="cr-display-2" style="margin:8px 0 8px"><span class="cr-d-thin">Lo que yo</span> publico.</h2>
        <p class="cr-lead" style="max-width:60ch;margin-bottom:32px">{PODCAST_SECTIONS.mine.intro}</p>

        <div style="display:flex;flex-direction:column;gap:24px">
          {mineEntries.map((p, i) => {
            const cover = i === 0 ? '/ds-assets/pertinente-cover.jpg' : '/ds-assets/memc-cover.jpg';
            const isPert = i === 0;
            const ctaHref = isPert ? '/pertinente' : '/metase';
            const ctaLabel = isPert ? 'Escuchar Pertinente' : 'Ver las conversaciones';
            const platforms = platformLinks(p).map((pl) => pl.label).join(' · ');
            return (
              <a class="cr-mediacard" href={ctaHref}>
                <div class="cr-mediacard__art" style={`background-image:url('${cover}')`}></div>
                <div class="cr-mediacard__body">
                  <div class="cr-mediacard__meta">{p.frequency ?? ''}</div>
                  <h3 class="cr-mediacard__title">{p.name}</h3>
                  <p class="cr-mediacard__desc">{p.description}</p>
                  <p class="cr-mediacard__foot">Escuchar en {platforms}</p>
                  <span class={`cr-btn ${isPert ? 'cr-btn--accent' : 'cr-btn--ghost'} cr-mediacard__cta`}>{ctaLabel}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- NEGOCIOS GROUP -->
    <section class="cr-blogix" style="padding-top:0">
      <div class="cr-container">
        <div class="cr-pgroup cr-pgroup--first" data-section="negocios">
          <p class="cr-eyebrow"><span class="cr-franja"></span>{PODCAST_SECTIONS.negocios.kicker} · {negociosEntries.length} podcasts</p>
          <h2 class="cr-pgroup__h"><span class="cr-d-thin">Los que escucho para</span> pensar el negocio y la IA.</h2>
          <p class="cr-pgroup__sub">{PODCAST_SECTIONS.negocios.intro}</p>
        </div>

        {negociosGroups.map((g) => (
          <div id={g.info.slug} class="cr-pcat" style={`--cat:${TAG_COLORS[g.tag]}`} data-tag={g.tag}>
            <div class="cr-pcat__head">
              <Fragment set:html={tagIcon(g.tag)} />
              <h3 class="cr-pcat__title">{g.info.label}</h3>
              <span class="cr-pcat__count">{g.items.length}</span>
            </div>
            <div class="cr-pcat__grid">
              {g.items.map((p) => (
                <div class="cr-pcast">
                  <h4 class="cr-pcast__name">{p.name}</h4>
                  {p.frequency && <p class="cr-pcast__cadence">{p.frequency}</p>}
                  <p class="cr-pcast__desc">{p.description}</p>
                  <div class="cr-pcast__links">
                    {platformLinks(p).map((pl) => (
                      <a href={pl.href} target="_blank" rel="noopener">{pl.label}</a>
                    ))}
                    {platformLinks(p).length === 0 && <span class="cr-pcast__plat">Sin enlace público</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FUERA GROUP -->
    <section class="cr-blogix" style="padding-top:0">
      <div class="cr-container">
        <div class="cr-pgroup" data-section="fuera">
          <p class="cr-eyebrow"><span class="cr-franja"></span>{PODCAST_SECTIONS.fuera.kicker} · {fueraEntries.length} podcasts</p>
          <h2 class="cr-pgroup__h"><span class="cr-d-thin">Lo que escucho cuando</span> no estoy pensando en IA.</h2>
          <p class="cr-pgroup__sub">{PODCAST_SECTIONS.fuera.intro}</p>
        </div>

        {fueraGroups.map((g) => (
          <div id={g.info.slug} class="cr-pcat" style={`--cat:${TAG_COLORS[g.tag]}`} data-tag={g.tag}>
            <div class="cr-pcat__head">
              <Fragment set:html={tagIcon(g.tag)} />
              <h3 class="cr-pcat__title">{g.info.label}</h3>
              <span class="cr-pcat__count">{g.items.length}</span>
            </div>
            <div class="cr-pcat__grid">
              {g.items.map((p) => (
                <div class="cr-pcast">
                  <h4 class="cr-pcast__name">{p.name}</h4>
                  {p.frequency && <p class="cr-pcast__cadence">{p.frequency}</p>}
                  <p class="cr-pcast__desc">{p.description}</p>
                  <div class="cr-pcast__links">
                    {platformLinks(p).map((pl) => (
                      <a href={pl.href} target="_blank" rel="noopener">{pl.label}</a>
                    ))}
                    {platformLinks(p).length === 0 && <span class="cr-pcast__plat">Sin enlace público</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <script is:inline>
    document.querySelectorAll('.cr-pchip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var f = chip.getAttribute('data-filter');
        document.querySelectorAll('.cr-pchip').forEach(function (c) { c.classList.remove('is-on'); });
        chip.classList.add('is-on');
        var cats = document.querySelectorAll('.cr-pcat');
        var groups = document.querySelectorAll('.cr-pgroup');
        if (f === 'todos') {
          cats.forEach(function (el) { el.style.display = ''; });
          groups.forEach(function (el) { el.style.display = ''; });
        } else {
          cats.forEach(function (el) {
            el.style.display = el.getAttribute('data-tag') === f ? '' : 'none';
          });
          // hide section headers whose tag children are all hidden
          groups.forEach(function (el) {
            var sec = el.getAttribute('data-section');
            var anyVisible = Array.from(cats).some(function (c) {
              return c.style.display !== 'none' && c.closest('section').contains(el);
            });
            el.style.display = anyVisible ? '' : 'none';
          });
        }
      });
    });
  </script>
</Base>
