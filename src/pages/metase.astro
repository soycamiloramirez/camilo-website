---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, PODCASTS } from '../content/copy';
import { loadPodcast } from '../lib/podcasts';

const lang = 'es' as const;
const feed = await loadPodcast({
  id: 'memc',
  title: 'Métase en mi cabeza',
  appleId: PODCASTS.memc.appleId,
  limit: 12,
});

const pageTitle = 'Métase en mi cabeza · Podcast semanal · Camilo Ramírez';
const pageDescription = 'Conversaciones semanales en vivo con líderes top de LATAM: ex CEO Google Colombia, ex Ministro TIC, VP Caracol, fundadores. IA con visión humana.';

const extraJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: 'Métase en mi cabeza',
    url: `${SITE.url}/metase`,
    description: pageDescription,
    inLanguage: 'es',
    author: { '@type': 'Person', name: 'Camilo Ramírez', url: SITE.url },
    sameAs: PODCASTS.memc.platforms.map((p) => p.href),
  },
];

const platforms = PODCASTS.memc.platforms;

function dateShort(iso: string) {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' });
}
---
<Base lang={lang} pageTitle={pageTitle} pageDescription={pageDescription} pageType="website" path="/metase" extraJsonLd={extraJsonLd}>
  <Header lang={lang} />

  <main>
    <section class="cr-pagehead cr-pagehead--dark">
      <div class="cr-container">
        <div class="cr-podhead">
          <div class="cr-podhead__art" style={`background-image:url('${feed.artworkUrl ?? '/ds-assets/memc-banner.png'}')`}></div>
          <div>
            <p class="cr-podhead__meta">Semanal · TV + podcast · ~60 min</p>
            <h1 class="cr-podhead__title">Métase en<br>mi cabeza</h1>
            <p class="cr-podhead__desc">Conversaciones en vivo con líderes top de la región: ex CEO de Google Colombia, ex Ministro TIC, VP de Caracol, fundadores. IA con visión humana, no técnica.</p>
            <div class="cr-podhead__platforms">
              {platforms.map((p) => (
                <a class="cr-platform" href={p.href} target="_blank" rel="noopener">{p.name}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="cr-episodes">
      <div class="cr-container">
        <h2 class="cr-display-2 cr-episodes__title"><span class="cr-d-thin">Conversa</span>ciones</h2>

        {feed.episodes.length === 0 ? (
          <p class="cr-lead">Las conversaciones viven en las plataformas de arriba. Ábralas directamente para no perderse las últimas.</p>
        ) : (
          feed.episodes.map((ep, i) => (
            <a class="cr-ep" href={ep.link || platforms[0].href} target="_blank" rel="noopener">
              <span class="cr-ep__num">{String(feed.episodes.length - i).padStart(2, '0')}</span>
              <div>
                <h3 class="cr-ep__title">{ep.title}</h3>
                <p class="cr-ep__desc">{ep.description}</p>
                <p class="cr-ep__desc" style="font-size:13px;opacity:.7;margin-top:4px">{dateShort(ep.published)}</p>
              </div>
              {ep.durationLabel && <span class="cr-ep__dur">{ep.durationLabel}</span>}
              <span class="cr-ep__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" style="width:15px;height:15px"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </a>
          ))
        )}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Base>
