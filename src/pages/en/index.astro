---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Ultimo from '../../components/Ultimo.astro';
import Tesis from '../../components/Tesis.astro';
import Trabajo from '../../components/Trabajo.astro';
import Roles from '../../components/Roles.astro';
import TrayectoriaBrief from '../../components/TrayectoriaBrief.astro';
import Contacto from '../../components/Contacto.astro';
import Footer from '../../components/Footer.astro';
import { SITE, PODCASTS } from '../../content/copy';

const lang = 'en' as const;

const extraJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/en`,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: 'Pertinente',
    description:
      'Daily podcast on AI, business and geopolitics in Latin America. Camilo Ramírez solo, the four news items that matter each day.',
    url: PODCASTS.pertinente.platforms[0].href,
    inLanguage: 'es',
    author: { '@type': 'Person', name: 'Camilo Ramírez', url: SITE.url },
    sameAs: PODCASTS.pertinente.platforms.map((p) => p.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: 'Métase en mi cabeza',
    description:
      'Weekly conversations with leaders building the present and future of Latin America. AI with a human lens. Produced by Navigamo, Got-It TV and AT Medios.',
    url: PODCASTS.memc.platforms[0].href,
    inLanguage: 'es',
    author: { '@type': 'Person', name: 'Camilo Ramírez', url: SITE.url },
    sameAs: PODCASTS.memc.platforms.map((p) => p.href),
  },
];
---
<Base lang={lang} path="/en" extraJsonLd={extraJsonLd}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Roles lang={lang} />
    <Ultimo lang={lang} />
    <Tesis lang={lang} />
    <Trabajo lang={lang} />
    <TrayectoriaBrief lang={lang} />
    <Contacto lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
