---
import { COPY, AIC_PARTNERS, type Lang } from '../content/copy';
import PartnerIcon from './PartnerIcon.astro';
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import H2 from './ui/H2.astro';
import Body from './ui/Body.astro';
import LinkButton from './ui/LinkButton.astro';

const { lang } = Astro.props as { lang: Lang };
const aic = COPY[lang].aic;
const nav = COPY[lang].navigamo;
---
<Section bordered wide class="space-y-16 md:space-y-20">
  <!-- Navigamo -->
  <article class="grid md:grid-cols-12 gap-8 md:gap-12 items-start">
    <div class="md:col-span-4">
      <Eyebrow class="mb-4">{nav.kicker}</Eyebrow>
      <a href={nav.href} target="_blank" rel="noopener" class="inline-block group" aria-label="Navigamo">
        <img src="/navigamo-logo.svg" alt="Navigamo" width="160" height="63"
          class="h-12 md:h-14 w-auto group-hover:opacity-70 transition-opacity" loading="lazy" />
      </a>
    </div>
    <div class="md:col-span-8">
      <H2 class="mb-5">{nav.title}</H2>
      <Body tone="primary" class="mb-6 max-w-xl">{nav.p}</Body>
      <p class="text-button text-ink/70 mb-3 max-w-xl italic">{nav.ctaIntro}</p>
      <LinkButton href={nav.href} external>{nav.cta} <span aria-hidden>↗</span></LinkButton>
    </div>
  </article>

  <!-- AI Collective -->
  <article class="grid md:grid-cols-12 gap-8 md:gap-12 items-start">
    <div class="md:col-span-4">
      <Eyebrow class="mb-4">{aic.kicker}</Eyebrow>
      <a href={aic.href} target="_blank" rel="noopener" class="inline-block group" aria-label="The AI Collective">
        <img src="/aicollective-logo.svg" alt="The AI Collective" width="180" height="86"
          class="h-12 md:h-14 w-auto group-hover:opacity-70 transition-opacity" loading="lazy" />
      </a>
    </div>
    <div class="md:col-span-8">
      <H2 class="mb-5">{aic.title}</H2>
      <Body tone="primary" class="mb-6 max-w-xl">{aic.p}</Body>
      <LinkButton href={aic.href} external>{aic.cta} <span aria-hidden>↗</span></LinkButton>

      <div class="mt-10 pt-8 border-t border-rule">
        <Eyebrow class="mb-5">{aic.partnersLabel}</Eyebrow>
        <ul class="flex flex-wrap items-center gap-x-7 gap-y-4">
          {AIC_PARTNERS.map((p) => (
            <li class="flex items-center gap-2 text-ink/70">
              <PartnerIcon name={p} className="h-4 w-auto shrink-0" />
              <span class="text-caption tracking-tight">{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </article>
</Section>
