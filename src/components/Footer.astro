---
import { SOCIALS, type Lang } from '../content/copy';
import PlatformIcon from './PlatformIcon.astro';
const { lang } = Astro.props as { lang: Lang };
const home = lang === 'es' ? '/' : '/en';
const pertinenteHref = lang === 'es' ? '/pertinente' : '/en/pertinente';
const metaseHref = lang === 'es' ? '/metase' : '/en/metase';
const blogHref = lang === 'es' ? '/blog' : '/en/blog';
const advisoryHref = `${home}#trabajar`;
const speakingHref = lang === 'es' ? '/speaking' : '/en/speaking';
const historiaHref = lang === 'es' ? '/historia' : '/en/historia';
const labels = lang === 'es'
  ? { contenido: 'Contenido', trabajo: 'Trabajo', redes: 'Redes', tag: 'Hecho con criterio en Bogotá.' }
  : { contenido: 'Content', trabajo: 'Work', redes: 'Social', tag: 'Built with judgment in Bogotá.' };
const tagline = lang === 'es'
  ? 'Criterio sobre IA, negocios y LATAM. Publicado todos los días.'
  : 'Judgment on AI, business and LATAM. Published every day.';
---
<footer class="cr-footer">
  <div class="cr-container cr-footer__inner">
    <div class="cr-footer__top">
      <div class="cr-footer__brand">
        <span class="cr-mark cr-mark--md cr-mark--ondark"><img src="/camilo-hero.jpg" alt="Retrato de Camilo Ramírez" width="52" height="52"></span>
        <span class="cr-footer__name">Camilo <span class="cr-footer__name-ac">Ramírez</span></span>
        <p class="cr-footer__tag">{tagline}</p>
      </div>
      <div class="cr-footer__cols">
        <div class="cr-footer__col">
          <span class="cr-footer__lbl">{labels.contenido}</span>
          <a href={pertinenteHref}>Pertinente</a>
          <a href={metaseHref}>Métase en mi cabeza</a>
          <a href={blogHref}>Blog</a>
        </div>
        <div class="cr-footer__col">
          <span class="cr-footer__lbl">{labels.trabajo}</span>
          <a href={advisoryHref}>Advisory</a>
          <a href={speakingHref}>Speaking</a>
          <a href={historiaHref}>{lang === 'es' ? 'Historia' : 'Story'}</a>
        </div>
        <div class="cr-footer__col">
          <span class="cr-footer__lbl">{labels.redes}</span>
          {SOCIALS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <PlatformIcon name={s.label} className="cr-social-ic" />
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="cr-footer__bottom">
      <span>© 2026 Camilo Ramírez.</span>
      <span>{labels.tag}</span>
    </div>
  </div>
</footer>
