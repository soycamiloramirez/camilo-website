---
import { COPY, SOCIALS, type Lang } from '../content/copy';
import PlatformIcon from './PlatformIcon.astro';
const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].footer;
---
<footer class="py-14 border-t border-rule">
  <div class="mx-auto max-w-6xl px-6 lg:px-10 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
    <div class="max-w-md">
      <p class="font-display text-h4 tracking-tight text-ink">Camilo Ramírez</p>
      <p class="mt-2 text-caption text-mute leading-relaxed">{t.legal}</p>
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-3 items-center">
      {SOCIALS.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}
            class="text-mute hover:text-accent transition-colors inline-flex">
            <PlatformIcon name={s.label} className="h-5 w-5" />
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p class="mx-auto max-w-6xl px-6 lg:px-10 mt-8 text-caption text-mute">{t.tagline}</p>
</footer>
