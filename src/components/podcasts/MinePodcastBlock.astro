---
import { PODCASTS } from '../../content/copy';
import { loadPodcast, type PodcastFeed } from '../../lib/podcasts';
import PlatformIcon from '../PlatformIcon.astro';

type Props = {
  variant: 'pertinente' | 'memc';
  name: string;
  frequency: string;
  description: string;
};
const { variant, name, frequency, description } = Astro.props as Props;
const cfg = PODCASTS[variant];
const feed: PodcastFeed = await loadPodcast({ id: cfg.id, title: name, appleId: cfg.appleId, limit: 1 });
const spotifyShowEmbed = `https://open.spotify.com/embed/show/${cfg.spotifyShowId}?utm_source=generator&theme=0`;
---
<article class="grid md:grid-cols-12 gap-8 md:gap-10 items-start">
  <div class="md:col-span-5">
    <div class="flex items-start gap-5 mb-5">
      {feed.artworkUrl && (
        <img src={feed.artworkUrl} alt={`${name} · cover art`} width="96" height="96" loading="lazy"
          class="w-[96px] h-[96px] shrink-0 border border-rule" />
      )}
      <div>
        <h3 class="font-display text-h3 tracking-tight leading-none mb-2">{name}</h3>
        <p class="text-eyebrow text-mute uppercase tracking-label">{frequency}</p>
      </div>
    </div>
    <p class="text-body leading-relaxed text-ink/75 mb-5 max-w-xl">{description}</p>
    <div class="flex items-center gap-5 text-mute">
      <span class="text-eyebrow uppercase tracking-eyebrow">Escuchar en</span>
      {cfg.platforms.map((p) => (
        <a href={p.href} target="_blank" rel="noopener" aria-label={p.name} title={p.name}
          class="hover:text-accent transition-colors">
          <PlatformIcon name={p.name} className="h-4 w-4" />
        </a>
      ))}
    </div>
  </div>
  <div class="md:col-span-7">
    <iframe
      src={spotifyShowEmbed}
      width="100%"
      height="232"
      frameborder="0"
      allowfullscreen
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
      title={`${name} · Spotify`}>
    </iframe>
  </div>
</article>
