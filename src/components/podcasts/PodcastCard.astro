---
import PlatformIcon from '../PlatformIcon.astro';
import type { PodcastEntry } from '../../content/podcasts';

const { podcast } = Astro.props as { podcast: PodcastEntry };
const links: { name: string; href: string }[] = [];
if (podcast.spotify) links.push({ name: 'Spotify', href: podcast.spotify });
if (podcast.youtube) links.push({ name: 'YouTube', href: podcast.youtube });
if (podcast.apple) links.push({ name: 'Apple', href: podcast.apple });
if (podcast.amazon) links.push({ name: 'Amazon', href: podcast.amazon });
if (podcast.web) links.push({ name: 'Web', href: podcast.web });
---
<article class="border-t border-rule pt-6 md:pt-7 pb-1">
  <div class="flex items-baseline justify-between gap-4 flex-wrap mb-2">
    <h3 class="font-display text-h4 leading-snug tracking-tight text-ink">{podcast.name}</h3>
    {podcast.frequency && (
      <span class="text-eyebrow uppercase tracking-label text-mute">{podcast.frequency}</span>
    )}
  </div>
  <p class="text-button md:text-body leading-relaxed text-ink/70 mb-4 max-w-2xl">{podcast.description}</p>
  {links.length > 0 ? (
    <div class="flex items-center gap-5 text-mute">
      {links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener nofollow" aria-label={`${podcast.name} en ${l.name}`} title={l.name}
          class="hover:text-accent transition-colors">
          <PlatformIcon name={l.name} className="h-4 w-4" />
        </a>
      ))}
    </div>
  ) : (
    <p class="text-caption text-mute italic">Búsquelo en su plataforma favorita.</p>
  )}
</article>
