---
import { COPY, SITE, type Lang } from '../content/copy';
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Display2 from './ui/Display2.astro';
import Lede from './ui/Lede.astro';
import Field from './ui/Field.astro';

const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].contacto;
---
<Section id="contacto" dark bordered narrow>
  <Eyebrow class="mb-5 text-paper/60">{t.kicker}</Eyebrow>
  <Display2 class="text-paper">{t.title}</Display2>
  <Lede class="mt-6 text-paper/80">{t.lede}</Lede>

  <form id="contact-form" class="mt-12 grid gap-6" autocomplete="on" data-email={SITE.email}>
    <Field name="name" label={t.form.name} type="text" required dark />
    <Field name="company" label={t.form.company} type="text" required dark />
    <fieldset class="grid gap-3">
      <legend class="text-eyebrow uppercase tracking-label text-paper/60 mb-1">{t.form.type}</legend>
      <div class="flex flex-wrap gap-2">
        {t.form.types.map((tp, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="type" value={tp} required={i === 0} checked={i === 0} class="peer sr-only" />
            <span class="inline-block px-4 py-2 border border-paper/25 text-button peer-checked:bg-paper peer-checked:text-ink peer-checked:border-paper transition-colors">{tp}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <Field name="message" label={t.form.message} type="textarea" rows={4} required dark />
    <div class="flex items-center justify-between mt-2 gap-6 flex-wrap">
      <button type="submit" class="inline-flex items-center gap-2 bg-paper text-ink px-6 py-3 text-button font-medium hover:opacity-80 transition-opacity">
        {t.form.send} <span aria-hidden>→</span>
      </button>
      <p class="text-caption text-paper/60">
        {t.form.emailFallback}
        <a href={`mailto:${SITE.email}`} class="text-paper underline decoration-paper/40 hover:decoration-paper underline-offset-4 ml-1">{SITE.email}</a>
      </p>
    </div>
  </form>
</Section>
<script is:inline>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const fd = new FormData(form);
    const email = form.dataset.email;
    const subject = encodeURIComponent(`[${fd.get('type')}] ${fd.get('name')} · ${fd.get('company')}`);
    const body = encodeURIComponent(
      `Nombre: ${fd.get('name')}\nEmpresa: ${fd.get('company')}\nTipo: ${fd.get('type')}\n\n${fd.get('message')}`
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
