---
import { CATEGORIES, type CategorySlug } from '../../content.config';
type Props = { current?: CategorySlug | 'all' };
const { current = 'all' } = Astro.props as Props;
const items = [
  { slug: 'all', label: 'Todos', href: '/blog' },
  ...Object.entries(CATEGORIES).map(([k, c]) => ({ slug: k, label: c.label, href: `/blog/categoria/${c.slug}` })),
];
---
<nav class="flex flex-wrap items-center gap-x-6 gap-y-3 mb-12">
  {items.map((it) => (
    <a href={it.href}
      class:list={[
        'text-[13px] uppercase tracking-[0.14em] transition-colors',
        it.slug === current ? 'text-ink font-medium underline decoration-accent decoration-2 underline-offset-[6px]' : 'text-mute hover:text-ink',
      ]}>
      {it.label}
    </a>
  ))}
</nav>
