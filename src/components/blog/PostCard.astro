---
import { CATEGORIES, type CategorySlug } from '../../content.config';
import type { CollectionEntry } from 'astro:content';

type Props = { post: CollectionEntry<'blog'>; size?: 'sm' | 'md' };
const { post, size = 'md' } = Astro.props as Props;
const fmt = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.date);
const cats = post.data.categories as CategorySlug[];
---
<article class:list={['border-t border-rule pt-6 md:pt-8 pb-2', size === 'sm' && 'pt-5']}>
  <div class="flex items-center gap-3 mb-3 flex-wrap">
    {cats.map((c) => (
      <a href={`/blog/categoria/${CATEGORIES[c].slug}`}
        class="text-eyebrow uppercase tracking-eyebrow text-accent hover:text-ink transition-colors">
        {CATEGORIES[c].label}
      </a>
    ))}
    <span class="text-eyebrow text-mute tabular-nums">{fmt}</span>
  </div>
  <h3 class:list={['font-display tracking-tight leading-display', size === 'sm' ? 'text-h4' : 'text-h3']}>
    <a href={`/blog/${post.id}`} class="text-ink hover:text-accent transition-colors">
      {post.data.title}
    </a>
  </h3>
  {size !== 'sm' && (
    <p class="mt-3 text-body leading-relaxed text-ink/70 max-w-2xl line-clamp-3">
      {post.data.description}
    </p>
  )}
</article>
