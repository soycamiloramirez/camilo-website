---
import { COPY, type Lang } from '../content/copy';
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Display2 from './ui/Display2.astro';
import H3 from './ui/H3.astro';
import Body from './ui/Body.astro';

const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].tesis;
---
<Section id="tesis" bordered wide>
  <Eyebrow class="mb-5">{t.kicker}</Eyebrow>
  <Display2 class="max-w-3xl">{t.title}</Display2>
  <div class="mt-14 grid md:grid-cols-3 gap-10 md:gap-12">
    {t.items.map((it, i) => (
      <div>
        <div class="font-display text-caption leading-none mb-6 tracking-eyebrow uppercase">
          <span class="text-accent font-semibold">0{i + 1}</span> <span class="text-mute">—</span>
        </div>
        <H3 class="mb-4">{it.h}</H3>
        <Body>{it.p}</Body>
      </div>
    ))}
  </div>
</Section>
