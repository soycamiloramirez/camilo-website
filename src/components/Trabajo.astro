---
import { COPY, type Lang } from '../content/copy';
const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].trabajo;
---
<section id="trabajo" class="py-24 md:py-32 border-t border-rule bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <p class="text-[11px] uppercase tracking-[0.18em] text-paper/60 mb-5">{t.kicker}</p>
    <h2 class="font-display text-[34px] md:text-[48px] leading-[1.08] tracking-tight max-w-3xl">{t.title}</h2>
    <div class="mt-14 grid md:grid-cols-2 gap-8 md:gap-12">
      {t.cards.map((c) => (
        <article class="border border-paper/15 p-8 md:p-10 hover:border-accent transition-colors">
          <span class="inline-block text-[11px] uppercase tracking-[0.18em] text-accent-soft mb-6">{c.tag}</span>
          <h3 class="font-display text-[26px] md:text-[30px] leading-snug tracking-tight mb-5">{c.h}</h3>
          <p class="text-[15px] leading-relaxed text-paper/80 mb-6">{c.p}</p>
          <p class="text-[13px] text-paper/55 italic">{c.for}</p>
        </article>
      ))}
    </div>
    <p class="mt-12 text-[15px] text-paper/70 max-w-3xl italic">{t.filter}</p>
  </div>
</section>
