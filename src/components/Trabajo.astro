---
import { COPY, type Lang } from '../content/copy';
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Display2 from './ui/Display2.astro';
import H2 from './ui/H2.astro';

const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].trabajo;
const speakingHref = lang === 'es' ? '/speaking' : '/en/speaking';
const ctaLabel = lang === 'es' ? 'Ver detalle de Speaking' : 'See Speaking details';
---
<Section id="trabajo" dark bordered wide>
  <Eyebrow class="mb-5 text-paper/60">{t.kicker}</Eyebrow>
  <Display2 class="max-w-3xl text-paper">{t.title}</Display2>
  <div class="mt-14 grid md:grid-cols-2 gap-8 md:gap-12">
    {t.cards.map((c) => {
      const isSpeaking = c.tag.toLowerCase() === 'speaking';
      return (
        <article class="border border-paper/15 p-8 md:p-10 hover:border-accent transition-colors">
          <span class="inline-block text-eyebrow uppercase tracking-eyebrow text-accent-soft mb-6">{c.tag}</span>
          <H2 class="mb-5 text-paper">{c.h}</H2>
          <p class="text-body leading-relaxed text-paper/80 mb-6">{c.p}</p>
          <p class="text-caption text-paper/55 italic">{c.for}</p>
          {isSpeaking && (
            <a href={speakingHref} class="inline-flex items-center gap-2 mt-6 text-caption font-medium text-paper underline decoration-accent-soft decoration-2 underline-offset-4 hover:text-accent-soft transition-colors">
              {ctaLabel} <span aria-hidden>→</span>
            </a>
          )}
        </article>
      );
    })}
  </div>
  <p class="mt-12 text-body text-paper/70 max-w-3xl italic">{t.filter}</p>
</Section>
