---
import { COPY, PODCASTS, type Lang } from '../content/copy';
import { loadPodcast } from '../lib/podcasts';
import PlatformIcon from './PlatformIcon.astro';
const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].ultimo;

const [pertinente, memc] = await Promise.all([
  loadPodcast({ id: 'pertinente', title: 'Pertinente', appleId: PODCASTS.pertinente.appleId, limit: 1 }),
  loadPodcast({ id: 'memc', title: 'MEMC', appleId: PODCASTS.memc.appleId, limit: 1 }),
]);

const fmt = (iso: string) =>
  iso ? new Intl.DateTimeFormat(lang === 'es' ? 'es-CO' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso)) : '';

const pertinenteLatest = pertinente.episodes[0];
const memcLatest = memc.episodes[0];

const spotifyShowEmbed = (id: string) => `https://open.spotify.com/embed/show/${id}?utm_source=generator&theme=0`;
---
<section id="ultimo" class="py-24 md:py-32 border-t border-rule">
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <p class="text-[11px] uppercase tracking-[0.18em] text-mute mb-5">{t.kicker}</p>
    <h2 class="font-display text-[34px] md:text-[48px] leading-[1.08] tracking-[-0.035em] max-w-3xl">{t.title}</h2>
    <p class="mt-6 text-[17px] leading-relaxed text-ink/75 max-w-3xl">{t.lede}</p>

    <div class="mt-16 grid md:grid-cols-2 gap-12 md:gap-14">
      <!-- Pertinente -->
      <article>
        <div class="flex items-start gap-5 mb-6">
          {pertinente.artworkUrl && (
            <img src={pertinente.artworkUrl} alt={`${t.pertinente.title} · cover art`}
              width="88" height="88" loading="lazy"
              class="w-[88px] h-[88px] shrink-0 border border-rule" />
          )}
          <div>
            <h3 class="font-display text-[28px] tracking-tight leading-none mb-2">{t.pertinente.title}</h3>
            <p class="text-[12px] text-mute uppercase tracking-[0.14em]">{t.pertinente.tag}</p>
          </div>
        </div>
        <p class="text-[15px] leading-relaxed text-ink/75 mb-6 max-w-xl">{t.pertinente.oneLine}</p>

        {pertinenteLatest && (
          <p class="text-[12px] text-mute mb-4">
            <span class="uppercase tracking-[0.14em]">{lang === 'es' ? 'Último episodio' : 'Latest episode'} ·</span>
            <span class="text-ink/80 ml-1">{pertinenteLatest.title}</span>
            <span class="ml-1">· {fmt(pertinenteLatest.published)}</span>
          </p>
        )}

        <div class="overflow-hidden">
          <iframe
            src={spotifyShowEmbed(PODCASTS.pertinente.spotifyShowId)}
            width="100%"
            height="232"
            frameborder="0"
            allowfullscreen
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title={`${t.pertinente.title} — Spotify`}>
          </iframe>
        </div>

        <div class="flex items-center gap-5 mt-6 text-mute">
          <span class="text-[10px] uppercase tracking-[0.18em]">{t.pertinente.listenLabel}</span>
          {PODCASTS.pertinente.platforms.map((p) => (
            <a href={p.href} target="_blank" rel="noopener" aria-label={p.name} title={p.name}
              class="text-mute hover:text-accent transition-colors">
              <PlatformIcon name={p.name} />
            </a>
          ))}
        </div>
      </article>

      <!-- MEMC -->
      <article>
        <div class="flex items-start gap-5 mb-6">
          {memc.artworkUrl && (
            <img src={memc.artworkUrl} alt={`${t.memc.title} · cover art`}
              width="88" height="88" loading="lazy"
              class="w-[88px] h-[88px] shrink-0 border border-rule" />
          )}
          <div>
            <h3 class="font-display text-[28px] tracking-tight leading-none mb-2">{t.memc.title}</h3>
            <p class="text-[12px] text-mute uppercase tracking-[0.14em]">{t.memc.tag}</p>
          </div>
        </div>
        <p class="text-[15px] leading-relaxed text-ink/75 mb-6 max-w-xl">{t.memc.oneLine}</p>

        {memcLatest && (
          <p class="text-[12px] text-mute mb-4">
            <span class="uppercase tracking-[0.14em]">{lang === 'es' ? 'Último episodio' : 'Latest episode'} ·</span>
            <span class="text-ink/80 ml-1">{memcLatest.title}</span>
            <span class="ml-1">· {fmt(memcLatest.published)}</span>
          </p>
        )}

        <div class="overflow-hidden">
          <iframe
            src={spotifyShowEmbed(PODCASTS.memc.spotifyShowId)}
            width="100%"
            height="232"
            frameborder="0"
            allowfullscreen
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title={`${t.memc.title} — Spotify`}>
          </iframe>
        </div>

        <div class="flex items-center gap-5 mt-6 text-mute">
          <span class="text-[10px] uppercase tracking-[0.18em]">{t.memc.listenLabel}</span>
          {PODCASTS.memc.platforms.map((p) => (
            <a href={p.href} target="_blank" rel="noopener" aria-label={p.name} title={p.name}
              class="text-mute hover:text-accent transition-colors">
              <PlatformIcon name={p.name} />
            </a>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>
