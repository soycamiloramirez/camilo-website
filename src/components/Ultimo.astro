---
import { COPY, PODCASTS, type Lang } from '../content/copy';
import { loadPodcast } from '../lib/podcasts';
import PlatformIcon from './PlatformIcon.astro';
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Display2 from './ui/Display2.astro';
import Lede from './ui/Lede.astro';
import H2 from './ui/H2.astro';

const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].ultimo;

const [pertinente, memc] = await Promise.all([
  loadPodcast({ id: 'pertinente', title: 'Pertinente', appleId: PODCASTS.pertinente.appleId, limit: 1 }),
  loadPodcast({ id: 'memc', title: 'MEMC', appleId: PODCASTS.memc.appleId, limit: 1 }),
]);

const fmt = (iso: string) =>
  iso ? new Intl.DateTimeFormat(lang === 'es' ? 'es-CO' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso)) : '';

const pertinenteLatest = pertinente.episodes[0];
const memcLatest = memc.episodes[0];

const spotifyShowEmbed = (id: string) => `https://open.spotify.com/embed/show/${id}?utm_source=generator&theme=0`;

const podcasts = [
  { cfg: PODCASTS.pertinente, copy: t.pertinente, feed: pertinente, latest: pertinenteLatest },
  { cfg: PODCASTS.memc, copy: t.memc, feed: memc, latest: memcLatest },
];
---
<Section id="ultimo" bordered wide>
  <Eyebrow class="mb-5">{t.kicker}</Eyebrow>
  <Display2 class="max-w-3xl">{t.title}</Display2>
  <Lede class="mt-6 max-w-3xl">{t.lede}</Lede>

  <div class="mt-16 grid md:grid-cols-2 gap-12 md:gap-14">
    {podcasts.map(({ cfg, copy, feed, latest }) => (
      <article>
        <div class="flex items-start gap-5 mb-6">
          {feed.artworkUrl && (
            <img src={feed.artworkUrl} alt={`${copy.title} · cover art`}
              width="88" height="88" loading="lazy"
              class="w-[88px] h-[88px] shrink-0 border border-rule" />
          )}
          <div>
            <H2 class="leading-none mb-2">{copy.title}</H2>
            <p class="text-caption text-mute uppercase tracking-label">{copy.tag}</p>
          </div>
        </div>
        <p class="text-body leading-relaxed text-ink/75 mb-6 max-w-xl">{copy.oneLine}</p>

        {latest && (
          <p class="text-caption text-mute mb-4">
            <span class="uppercase tracking-label">{lang === 'es' ? 'Último episodio' : 'Latest episode'} ·</span>
            <span class="text-ink/80 ml-1">{latest.title}</span>
            <span class="ml-1">· {fmt(latest.published)}</span>
          </p>
        )}

        <div class="overflow-hidden">
          <iframe
            src={spotifyShowEmbed(cfg.spotifyShowId)}
            width="100%"
            height="232"
            frameborder="0"
            allowfullscreen
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title={`${copy.title} · Spotify`}>
          </iframe>
        </div>

        <div class="flex items-center gap-5 mt-6 text-mute">
          <span class="text-eyebrow uppercase tracking-eyebrow">{copy.listenLabel}</span>
          {cfg.platforms.map((p) => (
            <a href={p.href} target="_blank" rel="noopener" aria-label={p.name} title={p.name}
              class="text-mute hover:text-accent transition-colors">
              <PlatformIcon name={p.name} />
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>
</Section>
