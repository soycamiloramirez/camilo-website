---
/**
 * H2 — títulos de bloque dentro de una sección (cards, capítulos,
 * sub-grupos). Token: `--text-h2`.
 */
type Props = {
  as?: 'h2' | 'h3' | 'h4' | 'div';
  class?: string;
};
const { as: Tag = 'h2', class: className = '' } = Astro.props as Props;
---
<Tag class={`font-display text-h2 leading-heading tracking-tight text-ink ${className}`}>
  <slot />
</Tag>
