---
/**
 * NewsletterForm — captura de email para el boletín semanal.
 *
 * Props:
 *   - variant: 'inline' (fila horizontal compacta, sin topics) | 'block' (vertical, con topics opcionales)
 *   - theme: 'light' (default) | 'dark'
 *   - id: prefijo único para los IDs del form (si hay más de uno en la página)
 *   - showTopics: muestra checkboxes de topics (default true en block, false en inline)
 */
interface Props {
  variant?: 'inline' | 'block';
  theme?: 'light' | 'dark';
  id?: string;
  showTopics?: boolean;
}
const { variant = 'inline', theme = 'light', id = 'nl', showTopics } = Astro.props as Props;
const renderTopics = showTopics ?? variant === 'block';
const formId = `${id}-form`;
const statusId = `${id}-status`;

const TOPICS = [
  { slug: 'negocios', label: 'Negocios y estrategia' },
  { slug: 'geopolitica', label: 'Geopolítica y mercado' },
  { slug: 'latam', label: 'LATAM' },
  { slug: 'aprende', label: 'Aprende' },
];
---

<form class={`cr-nl cr-nl--${variant} cr-nl--${theme}`} id={formId} action="/api/subscribe" method="POST" novalidate>
  <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden">
    <label>Website<input name="website" type="text" tabindex="-1" autocomplete="off"></label>
  </div>

  <label class="cr-nl__field">
    <span class="cr-nl__label">Su nombre</span>
    <input class="cr-nl__input" name="name" type="text" required minlength="2" autocomplete="given-name" placeholder="Camilo">
  </label>

  <label class="cr-nl__field">
    <span class="cr-nl__label">Su correo electrónico</span>
    <input class="cr-nl__input" name="email" type="email" required autocomplete="email" placeholder="usted@empresa.com">
  </label>

  {renderTopics && (
    <div class="cr-nl__topics">
      <p class="cr-nl__topics-lbl">¿Qué le interesa más? <span class="cr-nl__topics-opt">(opcional)</span></p>
      <div class="cr-nl__topics-grid">
        {TOPICS.map((t) => (
          <label class="cr-nl__chk">
            <input type="checkbox" name="topics" value={t.slug}>
            <span>{t.label}</span>
          </label>
        ))}
      </div>
    </div>
  )}

  <button class="cr-nl__submit" type="submit">Suscribirme →</button>
  <div class="cr-nl__status" id={statusId} aria-live="polite" hidden></div>
</form>

<script is:inline define:vars={{ formId, statusId }}>
  (function () {
    const form = document.getElementById(formId);
    if (!form) return;
    const submit = form.querySelector('.cr-nl__submit');
    const status = document.getElementById(statusId);
    if (!submit || !status) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      submit.disabled = true;
      const originalLabel = submit.textContent;
      submit.textContent = 'Enviando…';
      status.hidden = true;
      status.className = 'cr-nl__status';

      try {
        const fd = new FormData(form);
        const res = await fetch('/api/subscribe', { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          form.reset();
          status.className = 'cr-nl__status cr-nl__status--ok';
          status.innerHTML = '<strong>Revise su correo.</strong> Le mandé un link para confirmar la suscripción. Si no lo ve en 2 minutos, revise la carpeta de spam.';
          status.hidden = false;
        } else {
          status.className = 'cr-nl__status cr-nl__status--err';
          status.textContent = json.error || 'No pude registrar la suscripción. Intente de nuevo.';
          status.hidden = false;
        }
      } catch (err) {
        status.className = 'cr-nl__status cr-nl__status--err';
        status.textContent = 'Error de red. Intente de nuevo.';
        status.hidden = false;
      } finally {
        submit.disabled = false;
        submit.textContent = originalLabel || 'Suscribirme →';
      }
    });
  })();
</script>
