---
/**
 * NewsletterForm — captura de email para la carta del viernes.
 *
 * Usa el DS de forms (cr-field, cr-form__topic, cr-btn) con modificador
 * --light para fondos claros (el DS por defecto está pensado dark).
 *
 * Props:
 *   - variant: 'inline' (fila horizontal compacta, sin topics)
 *              | 'block'  (vertical, con topics opcionales)
 *   - id: prefijo único para los IDs (si hay más de uno en la página)
 *   - showTopics: muestra checkboxes de topics (default true en block, false en inline)
 */
interface Props {
  variant?: 'inline' | 'block';
  id?: string;
  showTopics?: boolean;
}
const { variant = 'inline', id = 'nl', showTopics } = Astro.props as Props;
const renderTopics = showTopics ?? variant === 'block';
const formId = `${id}-form`;
const statusId = `${id}-status`;

const TOPICS = [
  { slug: 'negocios', label: 'Negocios y estrategia' },
  { slug: 'geopolitica', label: 'Geopolítica y mercado' },
  { slug: 'latam', label: 'LATAM' },
  { slug: 'aprende', label: 'Aprende' },
];
---

<form
  class={`cr-form cr-form--light cr-form--nl cr-form--nl-${variant}`}
  id={formId}
  action="/api/subscribe"
  method="POST"
  novalidate
>
  {/* Honeypot anti-spam */}
  <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden">
    <label>Website<input name="website" type="text" tabindex="-1" autocomplete="off"></label>
  </div>

  <div class="cr-form__row">
    <label class="cr-field">
      <span class="cr-field__label">Nombre</span>
      <input class="cr-field__input" name="name" type="text" required minlength="2" autocomplete="given-name" placeholder="Camilo">
      <span class="cr-field__hint">Lo uso para escribirle a usted, no para una lista anónima. No lo comparto con nadie.</span>
    </label>
    <label class="cr-field">
      <span class="cr-field__label">Email</span>
      <input class="cr-field__input" name="email" type="email" required autocomplete="email" placeholder="usted@empresa.com">
    </label>
  </div>

  {renderTopics && (
    <div class="cr-field">
      <span class="cr-field__label">¿Qué le interesa más? <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--ink-3)">(opcional)</span></span>
      <span class="cr-field__hint">Hoy todos reciben la misma carta. Esto me ayuda a entender qué le pesa más y eventualmente personalizar lo que recibe.</span>
      <div class="cr-form__topics cr-form__topics--multi" role="group" style="margin-top:var(--s-3);flex-wrap:wrap">
        {TOPICS.map((t) => (
          <label class="cr-form__topic cr-form__topic--chk">
            <input type="checkbox" name="topics" value={t.slug}>
            <span>{t.label}</span>
          </label>
        ))}
      </div>
    </div>
  )}

  <button class="cr-btn cr-btn--accent cr-form__submit" type="submit">Suscribirme →</button>
  <div class="cr-form__status" id={statusId} aria-live="polite" hidden></div>
</form>

<script is:inline define:vars={{ formId, statusId }}>
  (function () {
    const form = document.getElementById(formId);
    if (!form) return;
    const submit = form.querySelector('.cr-form__submit');
    const status = document.getElementById(statusId);
    if (!submit || !status) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      submit.disabled = true;
      const originalLabel = submit.textContent;
      submit.textContent = 'Enviando…';
      status.hidden = true;
      status.className = 'cr-form__status';

      try {
        const fd = new FormData(form);
        const res = await fetch('/api/subscribe', { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          form.reset();
          status.className = 'cr-form__status cr-form__status--ok';
          status.innerHTML = '<strong>Revise su correo.</strong> Le mandé un link para confirmar la suscripción. Si no lo ve en 2 minutos, revise la carpeta de spam.';
          status.hidden = false;
        } else {
          status.className = 'cr-form__status cr-form__status--err';
          status.textContent = json.error || 'No pude registrar la suscripción. Intente de nuevo.';
          status.hidden = false;
        }
      } catch (err) {
        status.className = 'cr-form__status cr-form__status--err';
        status.textContent = 'Error de red. Intente de nuevo.';
        status.hidden = false;
      } finally {
        submit.disabled = false;
        submit.textContent = originalLabel || 'Suscribirme →';
      }
    });
  })();
</script>
