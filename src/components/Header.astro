---
import { COPY, type Lang } from '../content/copy';
const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang];
const home = lang === 'es' ? '/' : '/en';
const blogHref = lang === 'es' ? '/blog' : '/en/blog';
const podcastsHref = lang === 'es' ? '/podcasts' : '/en/podcasts';
const speakingHref = lang === 'es' ? '/speaking' : '/en/speaking';
const historiaHref = lang === 'es' ? '/historia' : '/en/historia';
const contactoHref = `${home}#contacto`;

/**
 * Lang switcher mantiene al usuario en la misma página, no lo manda al home.
 * Mapea path actual a su contraparte en el otro idioma. Si no existe paridad
 * (ej: /blog/SLUG no tiene EN), cae al fallback (/en/blog o /blog).
 */
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const PEERED = ['/historia', '/podcasts', '/speaking', '/pertinente', '/metase', '/blog'];

let otherHref: string;
if (lang === 'es') {
  if (currentPath === '/') {
    otherHref = '/en';
  } else if (PEERED.includes(currentPath)) {
    otherHref = `/en${currentPath}`;
  } else if (currentPath.startsWith('/blog/')) {
    // Posts y categorías no tienen peer EN, mandar al listado /en/blog
    otherHref = '/en/blog';
  } else {
    otherHref = '/en';
  }
} else {
  if (currentPath === '/en') {
    otherHref = '/';
  } else if (currentPath.startsWith('/en/')) {
    otherHref = currentPath.replace(/^\/en/, '') || '/';
  } else {
    otherHref = '/';
  }
}
---
<header class="cr-header">
  <div class="cr-header__inner">
    <a class="cr-header__brand" href={home}>
      <span class="cr-mark cr-mark--sm"><img src="/camilo-hero.jpg" alt=""></span>
      <span class="cr-header__brand-mark">Camilo <span class="cr-header__brand-r">Ramírez</span></span>
    </a>
    <input type="checkbox" id="cr-nav-toggle" class="cr-burger-cb" aria-hidden="true">
    <label for="cr-nav-toggle" class="cr-burger" aria-label="Menu"><span></span><span></span><span></span></label>
    <nav class="cr-header__nav">
      <a class="cr-header__navlink" href={blogHref}>{t.nav.blog}</a>
      <a class="cr-header__navlink" href={podcastsHref}>Podcasts</a>
      <a class="cr-header__navlink" href={speakingHref}>{t.nav.speaking}</a>
      <a class="cr-header__navlink" href={historiaHref}>{t.nav.historia}</a>
    </nav>
    <div class="cr-header__right">
      <span class="cr-header__lang">
        {lang === 'es' ? (
          <>ES <span class="cr-header__lang-sep">/</span> <a href={otherHref} class="cr-header__lang-off">EN</a></>
        ) : (
          <><a href={otherHref} class="cr-header__lang-off">ES</a> <span class="cr-header__lang-sep">/</span> EN</>
        )}
      </span>
      <a class="cr-btn cr-btn--primary cr-header__cta" href={contactoHref}>{t.nav.contacto}</a>
    </div>
  </div>
</header>

<style>
  /* Alinear baseline del switch ES/EN con los navlinks
     (estos tienen padding-bottom:4px + border-bottom:2px que los nudge abajo) */
  .cr-header__lang { padding-bottom: 6px; }
</style>
