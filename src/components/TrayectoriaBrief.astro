---
import { COPY, type Lang } from '../content/copy';
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Display2 from './ui/Display2.astro';
import Lede from './ui/Lede.astro';
import LinkButton from './ui/LinkButton.astro';

const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].trayectoriaBrief;
const historiaHref = lang === 'es' ? '/historia' : '/en/historia';
---
<Section id="trayectoria" bordered wide>
  <Eyebrow class="mb-5">{t.kicker}</Eyebrow>
  <Display2 class="max-w-3xl">{t.title}</Display2>
  <Lede class="mt-6 max-w-3xl">{t.lede}</Lede>
  <ol class="mt-12 border-t border-rule">
    {t.milestones.map((m) => (
      <li class="grid grid-cols-12 gap-6 border-b border-rule py-5">
        <span class="col-span-4 md:col-span-3 text-caption uppercase tracking-label text-mute font-medium">{m.years}</span>
        <span class="col-span-8 md:col-span-9 font-display text-h4 tracking-tight text-ink">{m.label}</span>
      </li>
    ))}
  </ol>
  <LinkButton href={historiaHref} class="mt-10">{t.cta} <span aria-hidden>→</span></LinkButton>
</Section>
