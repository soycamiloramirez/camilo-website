---
import { COPY, type Lang } from '../content/copy';
import Eyebrow from './ui/Eyebrow.astro';
import Display1 from './ui/Display1.astro';
import Display3 from './ui/Display3.astro';
import H3 from './ui/H3.astro';
import Lede from './ui/Lede.astro';
import Body from './ui/Body.astro';
import PrimaryButton from './ui/PrimaryButton.astro';

const { lang } = Astro.props as { lang: Lang };
const t = COPY[lang].speaking;
const contactHref = lang === 'es' ? '/#contacto' : '/en#contacto';
---
<article class="pt-32 pb-20 md:pt-40 md:pb-28">
  <!-- Hero -->
  <header class="mx-auto max-w-5xl px-s6 lg:px-s7">
    <Eyebrow class="mb-6">{t.eyebrow}</Eyebrow>
    <Display1 class="max-w-4xl">{t.title}</Display1>
    <Lede class="mt-8 max-w-2xl">{t.lede}</Lede>
    <PrimaryButton href={contactHref} class="mt-9">
      {t.ctaPrimary} <span aria-hidden>→</span>
    </PrimaryButton>
  </header>

  <!-- Diferenciador -->
  <section class="mx-auto max-w-3xl px-s6 lg:px-s7 mt-24 md:mt-32 border-t border-rule pt-12">
    <Eyebrow class="mb-5">{t.diferenciador.kicker}</Eyebrow>
    <Display3 class="mb-6">{t.diferenciador.h}</Display3>
    <Lede>{t.diferenciador.p}</Lede>
  </section>

  <!-- Temas -->
  <section class="mx-auto max-w-5xl px-s6 lg:px-s7 mt-24 md:mt-32">
    <Eyebrow class="mb-5">{t.temas.kicker}</Eyebrow>
    <Display3 class="mb-12 max-w-2xl">{t.temas.h}</Display3>
    <div class="grid md:grid-cols-3 gap-10 md:gap-12">
      {t.temas.items.map((item, i) => (
        <div>
          <div class="font-display text-caption leading-none mb-5 tracking-eyebrow uppercase">
            <span class="text-accent font-semibold">0{i + 1}</span> <span class="text-mute">—</span>
          </div>
          <H3 class="mb-4">{item.h}</H3>
          <Body>{item.p}</Body>
        </div>
      ))}
    </div>
  </section>

  <!-- Formatos -->
  <section class="mx-auto max-w-5xl px-s6 lg:px-s7 mt-24 md:mt-32 border-t border-rule pt-12">
    <Eyebrow class="mb-5">{t.formatos.kicker}</Eyebrow>
    <Display3 class="mb-12 max-w-2xl">{t.formatos.h}</Display3>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
      {t.formatos.items.map((f) => (
        <li>
          <h3 class="font-display text-h4 tracking-tight text-ink mb-2">{f.h}</h3>
          <p class="text-button leading-relaxed text-ink/70">{f.p}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Logística -->
  <section class="mx-auto max-w-5xl px-s6 lg:px-s7 mt-24 md:mt-32 border-t border-rule pt-12">
    <Eyebrow class="mb-5">{t.logistica.kicker}</Eyebrow>
    <Display3 class="mb-10 max-w-2xl">{t.logistica.h}</Display3>
    <dl class="grid sm:grid-cols-2 gap-x-10 gap-y-7 max-w-4xl">
      {t.logistica.items.map((it) => (
        <div>
          <dt class="text-eyebrow uppercase tracking-eyebrow text-mute mb-2">{it.label}</dt>
          <dd class="text-body text-ink/85 leading-relaxed">{it.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Prueba social -->
  <section class="mx-auto max-w-5xl px-s6 lg:px-s7 mt-24 md:mt-32 border-t border-rule pt-12">
    <Eyebrow class="mb-5">{t.pruebaSocial.kicker}</Eyebrow>
    <Display3 class="mb-4 max-w-2xl">{t.pruebaSocial.h}</Display3>
    <Body class="max-w-2xl mb-10">{t.pruebaSocial.p}</Body>
    <ol class="border-t border-rule">
      {t.pruebaSocial.items.map((ev) => (
        <li class="grid md:grid-cols-12 gap-4 md:gap-8 border-b border-rule py-6">
          <span class="md:col-span-3 text-caption uppercase tracking-label text-mute font-medium">{ev.year}</span>
          <div class="md:col-span-9">
            <h3 class="font-display text-h4 tracking-tight text-ink mb-2">{ev.event}</h3>
            <p class="text-button leading-relaxed text-ink/70 max-w-xl">{ev.context}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Docencia -->
  <section class="mx-auto max-w-5xl px-s6 lg:px-s7 mt-24 md:mt-32 border-t border-rule pt-12">
    <Eyebrow class="mb-5">{t.docencia.kicker}</Eyebrow>
    <Display3 class="mb-10 max-w-2xl">{t.docencia.h}</Display3>
    <ul class="grid md:grid-cols-3 gap-10">
      {t.docencia.items.map((it) => (
        <li>
          <h3 class="font-display text-h4 tracking-tight text-ink mb-3">{it.h}</h3>
          <p class="text-button leading-relaxed text-ink/70">{it.p}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Podcasts -->
  <section class="mx-auto max-w-5xl px-s6 lg:px-s7 mt-24 md:mt-32 border-t border-rule pt-12">
    <Eyebrow class="mb-5">{t.podcasts.kicker}</Eyebrow>
    <Display3 class="mb-10 max-w-2xl">{t.podcasts.h}</Display3>
    <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-6 max-w-3xl">
      {t.podcasts.items.map((p) => (
        <li>
          {p.url ? (
            <a href={p.url} target="_blank" rel="noopener" class="font-display text-h4 text-ink hover:text-accent transition-colors underline decoration-accent decoration-2 underline-offset-4">
              {p.name}
            </a>
          ) : (
            <span class="font-display text-h4 text-ink">{p.name}</span>
          )}
          <span class="block text-button text-mute mt-1">{p.topic}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-s6 lg:px-s7 mt-24 md:mt-32 border-t border-rule pt-12">
    <Eyebrow class="mb-5">{t.faq.kicker}</Eyebrow>
    <Display3 class="mb-12">{t.faq.h}</Display3>
    <dl class="space-y-8">
      {t.faq.items.map((qa) => (
        <div class="border-t border-rule pt-6">
          <dt class="font-display text-h4 tracking-tight text-ink mb-3">{qa.q}</dt>
          <dd class="text-body leading-relaxed text-ink/80">{qa.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Contacto -->
  <section class="mx-auto max-w-3xl px-s6 lg:px-s7 mt-24 md:mt-32 border-t border-ink pt-12">
    <Eyebrow class="mb-5">{t.contacto.kicker}</Eyebrow>
    <Display3 class="mb-5">{t.contacto.h}</Display3>
    <Body class="mb-8 max-w-xl">{t.contacto.p}</Body>
    <PrimaryButton href={contactHref}>
      {t.contacto.cta} <span aria-hidden>→</span>
    </PrimaryButton>
  </section>
</article>
